<configuration>
  <appSettings>
    <add key="apiUrl" value="http://10.100.3.236:9389/api" />
    <!--登录权限接口地址-->
    <add key="apiActionUrl" value="http://10.100.3.236:6666/api" />
    <!--工位操作接口地址-->
    <add key="sopUrl" value="http://10.100.3.236:6666/api" />
    <add key="sapUrl" value="http://10.100.3.236:6666/api" />
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="TimeOut" value="120" />
    <add key="bdjWarehouseApiUrl" value="http://172.20.63.179:8081" />
  </appSettings>
  <connectionStrings>
    <!-- 数据库主配置：所有项目（BillApi、ServiceAuto 等）统一读取本文件的 TRWCSConnection -->
    <!--<add name="TRWCSConnection" connectionString="Server=49.234.209.152;Database=SHACH008;User Id=root;password=Admin123456;Convert Zero Datetime=True;Allow Zero Datetime=True" providerName="MySql.Data.MySqlClient" />-->
    <!--<add name="TRWCSConnection" connectionString="Server=172.20.63.182;Database=jc0004;User Id=root;password=root;Convert Zero Datetime=True;Allow Zero Datetime=True" providerName="MySql.Data.MySqlClient" />-->
	  <add name="TRWCSConnection" connectionString="Server=localhost;Database=jc0004;User Id=root;password=123456;Convert Zero Datetime=True;Allow Zero Datetime=True;Charset=utf8;Pooling=true;Minimum Pool Size=0;Maximum Pool Size=100;Connection Lifetime=300;Connection Timeout=30;SslMode=none;AllowPublicKeyRetrieval=True" providerName="MySql.Data.MySqlClient" />
    <!--<add name="TRWCSConnection" connectionString="Server=192.168.12.17;Database=jc0004;User Id=root;password=root;Convert Zero Datetime=True;Allow Zero Datetime=True" providerName="MySql.Data.MySqlClient" />-->
  </connectionStrings>
  <!--
    有关 web.config 更改的说明，请参见 http://go.microsoft.com/fwlink/?LinkId=235367。

    可在 <httpRuntime> 标记上设置以下特性。
      <system.Web>
        <httpRuntime targetFramework="4.5" />
      </system.Web>
  -->
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.5" requestValidationMode="2.0" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" culture="zh-CN" uiCulture="zh-CN" />
  </system.web>
