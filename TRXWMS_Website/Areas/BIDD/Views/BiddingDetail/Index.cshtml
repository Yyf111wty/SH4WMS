    // 提交报价函数
    function submitQuote(id) {
        var inputValue = $('#quoteInput_' + id).val();
        var pattern = /^\d+$/; // 正则表达式，匹配一个或多个数字
        var indata = pattern.test(inputValue) && inputValue > 0; // 检查是否为正整数
        if (!inputValue || !indata) {
            layer.msg('请输入报价金额且只能是正整数');
            return;
        }
        else
        {
            $.ajax({
                async: false,
                type: "POST",
                url: '/BIDD/BiddingDetail/AddProduct',
                data: { PROJECTCODE: id, MYPRICE: inputValue },
                dataType: "json",
                success: function (data) {
                    if (data.result == true) {
                        //成功
                        //1.刷新我的出价表格，2.更新排名，3.更新剩余时间
                        $("#searchform").hide();
                        $("#rowbtn").hide();

                        $("#tabsbody").show();
                        $("#djsrow").show();
                        $("#djsbodyrow").show();
                      
                        loadbodyDatagrid(id);
                        startCountdownTimer(id);
                        hg.msg(data.msg);
                        //setTimeout(function () { searchClick(); }, 500);
                    }
                    else {
                        hg.msg(data.msg);
                    }

                },
                error: function (data) {
                    hg.msg(data.msg);
                }
            })

        }
       
        // 这里可以添加实际的提交逻辑
    }


    // 启动倒计时定时器
    //定时刷新排名，刷新剩余时间
    function startCountdownTimer(id) {
        setInterval(function () {
            $.ajax({
                async: false,
                type: "POST",
                url: '/BIDD/BiddingDetail/GetMyData',
                data: { PROJECTCODE: id },
                dataType: "json",
                success: function (data) {
                    if (data.result == true) {

                        //2.更新排名，3.更新剩余时间
                        var now = new Date(data.starttime).getTime();
                        var endTime = new Date(data.endtime).getTime();
                        var diff = endTime - now;

                        // 计算剩余时间
                        var days = Math.floor(diff / (1000 * 60 * 60 * 24));
                        var hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                        var minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                        var seconds = Math.floor((diff % (1000 * 60)) / 1000);
                        var livetime = days + '天' + hours + '时' + minutes + '分' + seconds + '秒';
                        if (diff <= 0) {
                            $("#dslbl").text("竞标剩余时间:已截止" );
                        }
                        else
                        {
                            $("#dslbl").text("竞标剩余时间:" + livetime);
                        }
                       
                        $("#dsbodylbl").text("当前排名为:第" + data.rank + "位!");
                    }
                    else {
                        $("#dslbl").text("获取数据报错");
                        $("#dsbodylbl").text("获取数据报错");
                    }

                },
                error: function (data) {
                    $("#dslbl").text("获取数据报错");
                    $("#dsbodylbl").text("获取数据报错");
                }
            })



        }, 1000);
    }

