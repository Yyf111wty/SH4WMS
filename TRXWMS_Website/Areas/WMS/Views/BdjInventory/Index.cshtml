    <style>
        .bdj-query-form .layui-inline { margin-bottom: 8px; vertical-align: middle; }
        .bdj-query-form .layui-input[type="text"],
        .bdj-query-form .layui-input[type="number"] {
            width: 140px;
        }
        .bdj-query-form .layui-input-inline.time-range { width: 280px; }
        .bdj-query-form .bdj-select-inline {
            width: auto;
        }
        .bdj-query-form .bdj-select-inline select {
            width: auto;
            min-width: 88px;
        }
        .bdj-query-form .bdj-select-inline .layui-form-select {
            width: auto;
            min-width: 88px;
        }
        .bdj-query-form .bdj-select-inline .layui-form-select .layui-input {
            width: auto !important;
            min-width: 88px;
            box-sizing: border-box;
        }
        .bdj-query-form .layui-form-select dl {
            min-width: unset;
            width: 100%;
            box-sizing: border-box;
        }
        .bdj-query-form .layui-form-select dl dd {
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .bdj-inventory-table .layui-table-cell {
            white-space: nowrap;
        }
        .layui-table-view[lay-id="bdjInventoryTable"] {
            width: 100% !important;
        }
        .layui-table-view[lay-id="bdjInventoryTable"] .layui-table-box,
        .layui-table-view[lay-id="bdjInventoryTable"] .layui-table-header,
        .layui-table-view[lay-id="bdjInventoryTable"] .layui-table-body {
            width: 100% !important;
        }
    </style>
</head>

<body class="layui-body-content">
    <div class="layui-fluid">
        <div class="layui-card">
            <div class="layui-card-header">
                <i class="iconfont">&#xe6ac;</i>&#22791;&#20992;&#26426;&#24211;&#23384;&#31649;&#29702;
                <span class="layui-layout-right">
                    <a href="javascript:;" hg-event="fullscreen">
                        <i class="layui-icon layui-icon-screen-full"></i>
                    </a>
                </span>
            </div>
            <div class="layui-card-body">
                <div class="layui-form bdj-query-form" lay-filter="bdjQueryForm">
                    <div class="layui-form-item">
                        <div class="layui-inline bdj-select-inline">
                            <select name="searchWarehouseId">
                                <option value="">&#20840;&#37096;&#20179;&#24211;</option>
                                <option value="0">&#22235;&#24211;&#20840;&#37096;</option>
                                <option value="1">&#20179;&#24211;A</option>
                                <option value="2">&#20179;&#24211;B</option>
                                <option value="3">&#20179;&#24211;C</option>
                                <option value="4">&#20179;&#24211;D</option>
                            </select>
                        </div>
                        <div class="layui-inline">
                            <input type="text" name="searchDiameter" placeholder="&#30452;&#24452;(&#27169;&#31946;)" class="layui-input" autocomplete="off">
                        </div>
                        <div class="layui-inline">
                            <input type="text" name="searchQrCode" placeholder="&#20108;&#32500;&#30721;(&#27169;&#31946;)" class="layui-input" autocomplete="off">
                        </div>
                        <div class="layui-inline bdj-select-inline">
                            <select name="searchIsExistBox">
                                <option value="">&#30418;&#29366;&#24577;</option>
                                <option value="0">&#31354;&#30418;</option>
                                <option value="1">&#28385;&#30418;</option>
                                <option value="2">&#39044;&#20998;&#37197;</option>
                                <option value="3">&#21322;&#30418;</option>
                                <option value="5">&#36864;&#28385;&#30418;</option>
                                <option value="6">&#24182;&#24211;&#30418;</option>
                            </select>
                        </div>
                        <div class="layui-inline">
                            <input type="number" name="searchStorey" placeholder="&#23618;" class="layui-input" min="0" autocomplete="off">
                        </div>
                        <div class="layui-inline">
                            <input type="number" name="searchCol" placeholder="&#21015;" class="layui-input" min="0" autocomplete="off">
                        </div>
                        <div class="layui-inline">
                            <input type="number" name="searchGrindCount" placeholder="&#30952;&#27425;" class="layui-input" min="0" autocomplete="off">
                        </div>
                        <div class="layui-inline">
                            <input type="number" name="searchMinRemain" placeholder="&#21097;&#20313;&#19979;&#38480;" class="layui-input" min="0" autocomplete="off">
                        </div>
                        <div class="layui-inline">
                            <input type="number" name="searchMaxRemain" placeholder="&#21097;&#20313;&#19978;&#38480;" class="layui-input" min="0" autocomplete="off">
                        </div>
                        <div class="layui-input-inline time-range">
                            <input type="text" id="dateRange" class="layui-input" placeholder="&#20837;&#24211;&#26102;&#38388;&#33539;&#22260;" autocomplete="off">
                        </div>
                        <div class="layui-inline">
                            <button type="button" class="layui-btn layui-btn-sm" onclick="searchClick()"><i class="layui-icon">&#xe615;</i>&#26597;&#35810;</button>
                            <button type="button" class="layui-btn layui-btn-primary layui-btn-sm" onclick="resetClick()"><i class="layui-icon">&#xe669;</i>&#37325;&#32622;</button>
                        </div>
                    </div>
                </div>
                <div class="layui-card-divs" id="group_div"></div>
                <table class="layui-hide bdj-inventory-table" id="bdjInventoryTable" lay-filter="bdjInventoryTable"></table>
            </div>
        </div>
        <div class="layui-floor">
            <blockquote class="layui-elem-quote layui-quote-nm">
                Copyright @@ks-jichen.com  2026-2027 All Rights Reserved.
            </blockquote>
        </div>
    </div>

    <script src="~/Scripts/formattodata.js"></script>
    <script src="~/Scripts/loadgroupformbutton.js?v=20261119"></script>
    <script>
        var BDJ_STATUS_FULL = '\u6ee1\u76d2';
        var BDJ_STATUS_HALF = '\u534a\u76d2';
        var BDJ_STATUS_EMPTY = '\u7a7a\u76d2';
        var BDJ_STATUS_PREALLOC = '\u9884\u5206\u914d';
        var bdjLastTableRows = [];

        $(function () {
            var pageId = GetQueryString('pageId');
            loadGroupFormButton(pageId);
            searchClick();
        });

        function formatStoreTime(val) {
            if (!val) {
                return '';
            }
            if (typeof val === 'string' && val.indexOf('/Date(') >= 0 && typeof FormatToDate === 'function') {
                return FormatToDate(val);
            }
            if (typeof val === 'string') {
                return val.replace('T', ' ').substring(0, 19);
            }
            return val;
        }

        function parseOptionalInt(value) {
            if (value === undefined || value === null || value === '') {
                return '';
            }
            return value;
        }

        function getSearchParams(data) {
            data = data || {};
            var params = {
                diameter: '',
                qrCode: '',
                warehouseId: '',
                isExistBox: '',
                storey: '',
                col: '',
                grindCount: '',
                minRemain: '',
                maxRemain: '',
                startTime: '',
                endTime: ''
            };

            var timeRange = $('#dateRange').val();
            if (timeRange) {
                var arr = timeRange.split(' - ');
                if (arr[0]) {
                    params.startTime = arr[0];
                }
                if (arr[1]) {
                    params.endTime = arr[1];
                }
            }

            if (data.searchDiameter) {
                params.diameter = data.searchDiameter;
            }
            if (data.searchQrCode) {
                params.qrCode = data.searchQrCode;
            }
            if (data.searchWarehouseId !== undefined && data.searchWarehouseId !== '') {
                params.warehouseId = parseInt(data.searchWarehouseId, 10);
            }
            if (data.searchIsExistBox !== undefined && data.searchIsExistBox !== '') {
                params.isExistBox = parseInt(data.searchIsExistBox, 10);
            }

            var storey = parseOptionalInt(data.searchStorey);
            if (storey !== '') {
                params.storey = parseInt(storey, 10);
            }
            var col = parseOptionalInt(data.searchCol);
            if (col !== '') {
                params.col = parseInt(col, 10);
            }
            var grindCount = parseOptionalInt(data.searchGrindCount);
            if (grindCount !== '') {
                params.grindCount = parseInt(grindCount, 10);
            }
            var minRemain = parseOptionalInt(data.searchMinRemain);
            if (minRemain !== '') {
                params.minRemain = parseInt(minRemain, 10);
            }
            var maxRemain = parseOptionalInt(data.searchMaxRemain);
            if (maxRemain !== '') {
                params.maxRemain = parseInt(maxRemain, 10);
            }

            return params;
        }

        function syncBdjSelectWidth() {
            $('.bdj-query-form .bdj-select-inline').each(function () {
                var $wrap = $(this);
                var $select = $wrap.find('select');
                var $formSelect = $wrap.find('.layui-form-select');
                var $input = $formSelect.find('.layui-input');
                if (!$select.length || !$input.length) {
                    return;
                }

                var $measure = $('<span></span>').css({
                    position: 'absolute',
                    visibility: 'hidden',
                    whiteSpace: 'nowrap',
                    fontSize: $input.css('font-size'),
                    fontFamily: $input.css('font-family'),
                    paddingLeft: $input.css('padding-left'),
                    paddingRight: '30px'
                }).appendTo('body');

                var maxWidth = 0;
                $select.find('option').each(function () {
                    $measure.text($(this).text());
                    maxWidth = Math.max(maxWidth, $measure.outerWidth());
                });
                $measure.remove();

                var width = Math.max(88, maxWidth);
                $formSelect.css('width', width + 'px');
                $input.css('width', width + 'px');
            });
        }

        function measureTextWidth(text) {
            var $measure = $('<span></span>').text(text || '').css({
                position: 'absolute',
                visibility: 'hidden',
                whiteSpace: 'nowrap',
                fontSize: '14px',
                fontFamily: 'Microsoft YaHei, sans-serif'
            }).appendTo('body');
            var width = $measure.outerWidth();
            $measure.remove();
            return width;
        }

        function getBdjCellText(row, field) {
            if (!row) {
                return '';
            }
            if (field === 'StoreTime') {
                return formatStoreTime(row.StoreTime);
            }
            if (field === 'BoxStatusDescription') {
                return row.BoxStatusDescription || '';
            }
            var val = row[field];
            if (val === null || val === undefined) {
                return '';
            }
            return String(val);
        }

        function calcBdjColWidth(title, rows, field, minWidth, maxWidth) {
            var width = measureTextWidth(title);
            (rows || []).forEach(function (row) {
                var text = getBdjCellText(row, field);
                if (text) {
                    width = Math.max(width, measureTextWidth(text));
                }
            });
            return Math.max(minWidth, Math.min(width + 28, maxWidth));
        }

        function getBdjTableCols(rows) {
            rows = rows || [];
            return [[
                { field: 'WarehouseName', title: '\u4ed3\u5e93', align: 'center', width: calcBdjColWidth('\u4ed3\u5e93', rows, 'WarehouseName', 60, 100), sort: true },
                { field: 'BoxNo', title: '\u5200\u76d2\u7f16\u53f7', align: 'center', width: calcBdjColWidth('\u5200\u76d2\u7f16\u53f7', rows, 'BoxNo', 72, 110), sort: true },
                { field: 'Storey', title: '\u5c42', align: 'center', width: calcBdjColWidth('\u5c42', rows, 'Storey', 48, 70), sort: true },
                { field: 'Col', title: '\u5217', align: 'center', width: calcBdjColWidth('\u5217', rows, 'Col', 48, 70), sort: true },
                { field: 'QRCode', title: '\u4e8c\u7ef4\u7801', align: 'center', width: calcBdjColWidth('\u4e8c\u7ef4\u7801', rows, 'QRCode', 72, 180), sort: true },
                { field: 'Diameter', title: '\u89c4\u683c(\u76f4\u5f84*M\u78e8\u6b21)', align: 'center', width: calcBdjColWidth('\u89c4\u683c(\u76f4\u5f84*M\u78e8\u6b21)', rows, 'Diameter', 120, 180), sort: true },
                { field: 'GrindCount', title: '\u78e8\u6b21', align: 'center', width: calcBdjColWidth('\u78e8\u6b21', rows, 'GrindCount', 48, 80), sort: true },
                {
                    field: 'BoxStatusDescription', title: '\u76d2\u72b6\u6001', align: 'center', width: calcBdjColWidth('\u76d2\u72b6\u6001', rows, 'BoxStatusDescription', 72, 110), sort: true, templet: function (d) {
                        var text = d.BoxStatusDescription || '';
                        if (text === BDJ_STATUS_FULL) {
                            return "<span class='layui-badge layui-bg-green'>" + text + "</span>";
                        }
                        if (text === BDJ_STATUS_HALF) {
                            return "<span class='layui-badge layui-bg-orange'>" + text + "</span>";
                        }
                        if (text === BDJ_STATUS_EMPTY) {
                            return "<span class='layui-badge layui-bg-gray'>" + text + "</span>";
                        }
                        if (text === BDJ_STATUS_PREALLOC) {
                            return "<span class='layui-badge layui-bg-blue'>" + text + "</span>";
                        }
                        if (text) {
                            return "<span class='layui-badge'>" + text + "</span>";
                        }
                        return '';
                    }
                },
                { field: 'Remain', title: '\u5269\u4f59\u9488\u6570', align: 'center', width: calcBdjColWidth('\u5269\u4f59\u9488\u6570', rows, 'Remain', 72, 110), sort: true },
                {
                    field: 'StoreTime', title: '\u5165\u5e93\u65f6\u95f4', align: 'center', width: calcBdjColWidth('\u5165\u5e93\u65f6\u95f4', rows, 'StoreTime', 140, 170), sort: true, templet: function (d) {
                        return formatStoreTime(d.StoreTime);
                    }
                }
            ]];
        }

        function getBdjTableContainerWidth($view) {
            return $view.find('.layui-table-box').width() || $view.width() || 0;
        }

        function stretchBdjTableCols(cols, containerWidth) {
            if (!cols || !cols.length || !containerWidth) {
                return cols;
            }

            var total = 0;
            for (var i = 0; i < cols.length; i++) {
                total += cols[i].width;
            }
            if (total <= 0 || total >= containerWidth) {
                return cols;
            }

            var extra = containerWidth - total;
            var assigned = 0;
            var stretched = cols.slice();
            for (var j = 0; j < stretched.length; j++) {
                var add = j === stretched.length - 1
                    ? (extra - assigned)
                    : Math.floor(extra * (stretched[j].width / total));
                stretched[j].width += add;
                assigned += add;
            }
            return stretched;
        }

        function applyBdjColumnWidthsToDom($view, cols, containerWidth) {
            cols.forEach(function (col, index) {
                var widthPx = col.width + 'px';
                $view.find('colgroup col').eq(index).attr('width', col.width);
                $view.find('th[data-field="' + col.field + '"] .layui-table-cell').css('width', widthPx);
                $view.find('td[data-field="' + col.field + '"] .layui-table-cell').css('width', widthPx);
            });

            var tableWidth = containerWidth + 'px';
            $view.find('.layui-table-header table, .layui-table-body table').css('width', tableWidth);
        }

        function bindBdjTableColAutoFit() {
            if (window.__bdjColAutoFitBound) {
                return;
            }
            window.__bdjColAutoFitBound = true;
            $(document).ajaxSuccess(function (event, xhr, settings) {
                if (!settings.url || settings.url.indexOf('/WMS/BdjInventory/Getlist') < 0) {
                    return;
                }
                try {
                    var res = JSON.parse(xhr.responseText);
                    bdjLastTableRows = res.rows || [];
                    setTimeout(function () {
                        applyBdjAdaptiveColumnWidths(bdjLastTableRows);
                    }, 0);
                } catch (e) { }
            });
            $(window).on('resize.bdjInventoryTable', function () {
                applyBdjAdaptiveColumnWidths(bdjLastTableRows);
            });
        }

        function applyBdjAdaptiveColumnWidths(rows) {
            var $view = $('.layui-table-view[lay-id="bdjInventoryTable"]');
            if (!$view.length) {
                return;
            }

            var containerWidth = getBdjTableContainerWidth($view);
            var cols = stretchBdjTableCols(getBdjTableCols(rows)[0], containerWidth);
            applyBdjColumnWidthsToDom($view, cols, containerWidth);

            if (typeof layui !== 'undefined') {
                layui.use(['table'], function () {
                    layui.table.resize('bdjInventoryTable');
                });
            }
        }

        function loadDatagrid(params) {
            if (typeof hg === 'undefined' || !hg.table) {
                console.error('hg.table is not ready');
                return;
            }

            bindBdjTableColAutoFit();
            var tableCols = getBdjTableCols([]);

            hg.table.datatable('bdjInventoryTable', '\u5907\u5200\u673a\u5e93\u5b58', '/WMS/BdjInventory/Getlist',
                params,
                tableCols, '', true, 'full-255');

            setTimeout(function () {
                applyBdjAdaptiveColumnWidths([]);
            }, 0);
        }

        function searchClick() {
            layui.use(['form', 'layer', 'jquery', 'laydate'], function () {
                $ = layui.jquery;
                var form = layui.form;
                var laydate = layui.laydate;

                if (!$('#dateRange').attr('lay-key')) {
                    laydate.render({
                        elem: '#dateRange',
                        type: 'datetime',
                        range: true,
                        format: 'yyyy-MM-dd HH:mm:ss'
                    });
                }

                form.render();
                syncBdjSelectWidth();
                var data = form.val('bdjQueryForm') || {};
                var params = getSearchParams(data);

                if (typeof hg !== 'undefined' && hg.table && hg.table.datatablestatus && hg.table.datatablestatus.bdjInventoryTable) {
                    hg.table.datatable('bdjInventoryTable', 'reload', params);
                    return;
                }

                loadDatagrid(params);
            });
        }

        function resetClick() {
            layui.use(['form'], function () {
                var form = layui.form;
                $('#dateRange').val('');
                form.val('bdjQueryForm', {
                    searchWarehouseId: '',
                    searchIsExistBox: '',
                    searchDiameter: '',
                    searchQrCode: '',
                    searchStorey: '',
                    searchCol: '',
                    searchGrindCount: '',
                    searchMinRemain: '',
                    searchMaxRemain: ''
                });
                form.render();
                syncBdjSelectWidth();
                searchClick();
            });
        }

        function GetQueryString(name) {
            var reg = new RegExp('(^|&)' + name + '=([^&]*)(&|$)', 'i');
            var r = window.location.search.substr(1).match(reg);
            if (r != null) {
                return decodeURIComponent(r[2]);
            }
            return null;
        }
    </script>
</body>
</html>
