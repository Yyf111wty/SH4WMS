
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>盒内针明细</title>
    <meta name="renderer" content="webkit|ie-comp|ie-stand">
    <meta http-equiv="hg-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width,minimum-scale=1.0,maximum-scale=1.0,user-scalable=no">
    <meta http-equiv="Cache-Control" content="no-siteapp" />
    <link rel="stylesheet" href="~/css/font.css">
    <link rel="stylesheet" href="~/lib/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/lib/admin/admin.css" media="all">
    <script type="text/javascript" src="~/lib/admin/jquery-1.9.1.min.js"></script>
    <script type="text/javascript" src="~/lib/layui/layui.js"></script>
    <script type="text/javascript" src="~/lib/admin/admin.js"></script>
    <style type="text/css">
        .needle-meta { padding: 6px 12px; line-height: 2; font-size: 13px; }
        .needle-meta b { margin-right: 4px; color: #666; }
        .slot-grid { display: grid; gap: 6px; padding: 8px 4px; }
        .slot-card { min-height: 92px; border: 1px solid #e2e2e2; border-radius: 4px; padding: 5px 7px; cursor: pointer; background: #fff; font-size: 12px; position: relative; }
        .slot-card:hover { box-shadow: 0 2px 6px rgba(0,0,0,.15); border-color: #16b777; }
        .slot-card .slot-pos { position: absolute; right: 8px; top: 6px; color: #999; font-weight: bold; }
        .slot-card .slot-no { font-size: 13px; font-weight: bold; word-break: break-all; margin: 2px 0 4px 0; }
        .slot-card .slot-line { color: #666; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .slot-card.empty { border-style: dashed; background: #fafafa; cursor: default; min-height: 40px; }
        .slot-card.slot-off { border: none; background: transparent; visibility: hidden; min-height: 0; }
        .slot-card.empty:hover { box-shadow: none; border-color: #e2e2e2; }
        .slot-card.empty .slot-no { color: #ccc; font-weight: normal; }
        .slot-card.st-RESERVED { border-color: #ffb800; }
        .slot-card.st-OUTBOUND { border-color: #1E9FFF; background: #f5faff; }
        .slot-card.st-QUARANTINED { border-color: #ff5722; background: #fff5f5; }
        .slot-card.st-BIND_CANCELLED { opacity: .55; }
        .tmp-flag { display: inline-block; background: #16b777; color: #fff; border-radius: 2px; padding: 0 4px; font-size: 11px; margin-left: 4px; }
        .cnt-badge { display: inline-block; margin-right: 6px; }
    </style>
</head>

<body class="layui-body-content">
    <div class="layui-fluid">
        <div class="layui-card">
            <div class="layui-card-header">
                <i class="iconfont">&#xe6ac;</i>盒内针明细
                <span class="layui-layout-right">
                    <a href="javascript:;" hg-event="fullscreen">
                        <i class="layui-icon layui-icon-screen-full"></i>
                    </a>
                </span>
            </div>
            <div class="layui-card-body">
                <div class="layui-form" style="margin-bottom:6px;">
                    <div class="layui-form-item">
                        <div class="layui-inline">
                            <input type="text" id="searchContainer" class="layui-input" placeholder="盒号" style="width:220px;">
                        </div>
                        <div class="layui-inline">
                            <button type="button" class="layui-btn layui-btn-sm" onclick="loadByInput()"><i class="layui-icon">&#xe615;</i>查询</button>
                        </div>
                    </div>
                </div>
                <div id="boxMeta" class="needle-meta layui-card"></div>
                <div id="slotGrid" class="slot-grid"></div>
                <div id="slotLoading" style="padding:20px;color:#888;">加载中...</div>
            </div>
        </div>
        <div class="layui-floor">
            <blockquote class="layui-elem-quote layui-quote-nm">
                Copyright @@ks-jichen.com  2026-2027 All Rights Reserved.
            </blockquote>
        </div>
    </div>

</body>
</html>
<script src="~/Scripts/formattodata.js"></script>
<script src="~/Scripts/loadgroupformbutton.js?v=20261119"></script>
<script>
    // 单针改造·查询页面：状态/事件字典（与单针追溯页一致）
    var STATUS_MAP = {
        'INBOUND_PENDING': { text: '待入库', css: 'layui-bg-gray' },
        'AVAILABLE': { text: '可用', css: 'layui-bg-green' },
        'RESERVED': { text: '预占', css: 'layui-bg-orange' },
        'OUTBOUND': { text: '已出库', css: 'layui-bg-blue' },
        'BIND_CANCELLED': { text: '绑定取消', css: 'layui-bg-black' },
        'ADJUSTED_OUT': { text: '调整出库', css: 'layui-bg-cyan' },
        'QUARANTINED': { text: '隔离', css: 'layui-bg-red' }
    };
    var BIZTYPE_MAP = {
        'BIND': '绑定',
        'BIND_CANCEL': '取消绑定',
        'INBOUND': '入库',
        'RESERVE': '出库预占',
        'UNRESERVE': '取消预占',
        'OUTBOUND': '出库完成',
        'ADJUST_OUT': '调整出库',
        'QUARANTINE': '隔离'
    };

    var g_rows = [];
    var g_container = '';

    $(function () {
        var pageId = GetQueryString('pageId');
        loadGroupFormButton(pageId);

        var ctn = GetQueryString('container');
        if (ctn) {
            $('#searchContainer').val(decodeURIComponent(ctn));
            loadBox(ctn);
        } else {
            $('#slotLoading').text('请输入盒号查询');
            $('#boxMeta').hide();
        }
    });

    function loadByInput() {
        var ctn = $.trim($('#searchContainer').val());
        if (!ctn) {
            hg.msg('请输入盒号');
            return;
        }
        loadBox(ctn);
    }

    function loadBox(container) {
        $('#slotLoading').show().text('加载中...');
        $('#slotGrid').empty();
        $.ajax({
            type: 'get',
            url: '/WMS/Needle/GetContainerData',
            data: { container: container },
            dataType: 'json',
            success: function (res) {
                if (!res || !res.success) {
                    $('#slotLoading').text(res && res.error ? res.error : '查询失败');
                    $('#boxMeta').hide();
                    return;
                }
                g_rows = res.rows || [];
                g_container = res.container || container;
                renderMeta(res);
                renderSlots();
            },
            error: function () {
                $('#slotLoading').text('请求失败');
            }
        });
    }

    function renderMeta(res) {
        var counts = {};
        var items = {};
        for (var i = 0; i < res.rows.length; i++) {
            counts[res.rows[i].STATUS] = (counts[res.rows[i].STATUS] || 0) + 1;
            if (res.rows[i].ITEMCODE) { items[res.rows[i].ITEMCODE] = true; }
        }
        var itemText = Object.keys(items).join(' / ') || '-';

        var badgeHtml = '';
        for (var s in STATUS_MAP) {
            if (counts[s]) {
                badgeHtml += "<span class='cnt-badge layui-badge " + STATUS_MAP[s].css + "'>" + STATUS_MAP[s].text + ' ' + counts[s] + '</span>';
            }
        }

        $('#boxMeta').show().html(
            '<div><b>盒号：</b>' + escapeHtml(res.container)
            + '　<b>库位：</b>' + escapeHtml(res.locationcode || '未占用库位')
            + '　<b>规格：</b>' + escapeHtml(itemText)
            + '　<b>针数：</b>' + res.rows.length + '</div>'
            + '<div><b>状态分布：</b>' + (badgeHtml || '无')
        );
        //+ '　<a href="/WMS/Needle/Index?CONTAINER=' + encodeURIComponent(res.container) + '" class="layui-badge layui-bg-blue" style="margin-left:8px;">按盒号去单针追溯</a></div>'
    }

    function isTempNeedle(no) {
        return typeof no === 'string' && no.indexOf('T-') === 0;
    }

    function statusText(status) {
        return STATUS_MAP[status] ? STATUS_MAP[status].text : (status || '');
    }

    function renderSlots() {
        $('#slotLoading').hide();
        if (!g_rows.length) {
            $('#slotGrid').html('<div style="color:#888;padding:12px;">该盒暂无针数据（可能为单针改造上线前入库的历史盒）</div>');
            return;
        }

        var byPos = {};
        var maxPos = 50;
        var zeroPos = [];
        for (var i = 0; i < g_rows.length; i++) {
            var r = g_rows[i];
            var p = r.POSITIONCODE || 0;
            if (p === 0) { zeroPos.push(r); continue; }
            if (!byPos[p]) { byPos[p] = []; }
            byPos[p].push(r);
            if (p > maxPos) { maxPos = p; }
        }

        // 盒内真实排列：列优先编号，1~10 为第 1 列（自上而下），11~20 第 2 列……
        // 每列固定 10 行；列数=ceil(maxPos/10)（50 针即 5 列，超出自动加列）
        var ROWS = 10;
        var cols = Math.ceil(maxPos / ROWS);
        var html = '<div class="slot-grid" style="grid-template-columns:repeat(' + cols + ',158px);">';
        for (var row = 1; row <= ROWS; row++) {
            for (var c = 0; c < cols; c++) {
                var pos = row + c * ROWS;
                if (pos > maxPos) {
                    html += '<div class="slot-card slot-off"></div>';
                } else if (!byPos[pos]) {
                    html += '<div class="slot-card empty"><span class="slot-pos">' + pos + '</span><div class="slot-no">空位</div></div>';
                } else {
                    var list = byPos[pos];
                    html += slotCardHtml(pos, list[0], list.length > 1 ? ('同位1/' + list.length) : '');
                }
            }
        }
        html += '</div>';
        // 槽位为 0 的兜底行（异常数据也展示出来）
        if (zeroPos.length) {
            html += '<div style="margin-top:10px;color:#999;font-size:12px;">槽位异常(0)的针：</div><div class="slot-grid" style="grid-template-columns:repeat(auto-fill,158px);">';
            for (var z = 0; z < zeroPos.length; z++) {
                html += slotCardHtml(0, zeroPos[z], '');
            }
            html += '</div>';
        }
        $('#slotGrid').html(html);
    }

    function slotCardHtml(pos, r, sub) {
        var tmp = isTempNeedle(r.NEEDLENO) ? '<span class="tmp-flag">临时</span>' : '';
        var reserve = r.RESERVEORDER ? ('预占:' + escapeHtml(r.RESERVEORDER)) : '';
        var task = r.OUTBOUNDORDER ? ('出库单:' + escapeHtml(r.OUTBOUNDORDER)) : '';
        var destParts = [];
        if (r.OUTTARGET) { destParts.push('口:' + escapeHtml(String(r.OUTTARGET))); }
        if (r.OUTMACHINENO !== null && r.OUTMACHINENO !== undefined && r.OUTMACHINENO !== '') { destParts.push('机台:' + escapeHtml(String(r.OUTMACHINENO))); }
        var dest = destParts.length ? ('去向:' + destParts.join(' ')) : '';
        return '<div class="slot-card st-' + escapeHtml(r.STATUS || '') + '" data-needle="' + escapeHtml(r.NEEDLENO) + '" title="点击查看详情与履历">'
            + '<span class="slot-pos">' + pos + (sub ? (' ' + sub) : '') + '</span>'
            + '<div class="slot-no">' + escapeHtml(r.NEEDLENO || '') + tmp + '</div>'
            + '<div class="slot-line">' + escapeHtml(r.ITEMCODE || '') + '　<span class="layui-badge ' + (STATUS_MAP[r.STATUS] ? STATUS_MAP[r.STATUS].css : 'layui-bg-gray') + '">' + escapeHtml(statusText(r.STATUS)) + '</span></div>'
            + '<div class="slot-line">' + escapeHtml(reserve || '-') + '</div>'
            + '<div class="slot-line">' + escapeHtml(task || '-') + '</div>'
            + (dest ? ('<div class="slot-line">' + dest + '</div>') : '')
            + '</div>';
    }

    // 详情+履历弹层
    $('#slotGrid').on('click', '.slot-card', function () {
        var needleNo = $(this).attr('data-needle');
        if (!needleNo) {
            return;
        }
        showNeedleDetail(needleNo);
    });

    function showNeedleDetail(needleNo) {
        layui.use(['layer'], function () {
            $.ajax({
                type: 'get',
                url: '/WMS/Needle/GetHistory',
                data: { needleNo: needleNo },
                dataType: 'json',
                success: function (res) {
                    var r = null;
                    for (var i = 0; i < g_rows.length; i++) {
                        if (g_rows[i].NEEDLENO === needleNo) { r = g_rows[i]; break; }
                    }
                    var head = r ? ('<div style="padding:10px 12px;border-bottom:1px solid #eee;line-height:1.9;">'
                        + '<div><b>针号：</b>' + escapeHtml(r.NEEDLENO) + (isTempNeedle(r.NEEDLENO) ? '<span class="tmp-flag">临时针</span>' : '') + '</div>'
                        + '<div><b>规格：</b>' + escapeHtml(r.ITEMCODE || '') + '　<b>盒号：</b>' + escapeHtml(r.CONTAINER || '') + '　<b>槽位：</b>' + (r.POSITIONCODE || '') + '</div>'
                        + '<div><b>状态：</b><span class="layui-badge ' + (STATUS_MAP[r.STATUS] ? STATUS_MAP[r.STATUS].css : 'layui-bg-gray') + '">' + escapeHtml(statusText(r.STATUS)) + '</span>'
                        + '　<b>入库单：</b>' + escapeHtml(r.INBOUNDORDER || '-')
                        + '　<b>预占单：</b>' + escapeHtml(r.RESERVEORDER || '-')
                        + '　<b>出库单：</b>' + escapeHtml(r.OUTBOUNDORDER || '-') + '</div>'
                        + '<div><b>最后更新：</b>' + FormatToDate(r.LASTEDITTIME) + '</div></div>') : '';

                    var body = '<div id="needleHistoryBox" style="padding:12px;">加载中...</div>';
                    layer.open({
                        type: 1,
                        title: '针明细与履历 - ' + escapeHtml(needleNo),
                        area: ['880px', '80%'],
                        content: '<div>' + head + body + '</div>'
                    });

                    if (!res || !res.success) {
                        $('#needleHistoryBox').html(escapeHtml(res && res.error ? res.error : '履历查询失败'));
                        return;
                    }
                    if (!res.rows || !res.rows.length) {
                        $('#needleHistoryBox').html('<div style="color:#888;">暂无履历记录</div>');
                        return;
                    }
                    $('#needleHistoryBox').html(buildHistoryHtml(res.rows));
                },
                error: function () {
                    hg.msg('请求失败');
                }
            });
        });
    }

    function posText(container, position) {
        var c = container ? escapeHtml(container) : '-';
        var p = (position === null || position === undefined || position === '') ? '' : ('#' + position);
        return c + p;
    }

    function buildHistoryHtml(rows) {
        var html = '';
        for (var i = rows.length - 1; i >= 0; i--) {
            var r = rows[i];
            var bizName = BIZTYPE_MAP[r.BIZTYPE] || (r.BIZTYPE || '');
            var fromTo = '';
            if (r.FROMSTATUS || r.TOSTATUS) {
                fromTo = escapeHtml(statusText(r.FROMSTATUS) + ' → ' + statusText(r.TOSTATUS));
            }
            var posChange = '';
            if ((r.FROMCONTAINER || r.TOCONTAINER) && (r.FROMCONTAINER !== r.TOCONTAINER || r.FROMPOSITION !== r.TOPOSITION)) {
                posChange = posText(r.FROMCONTAINER, r.FROMPOSITION) + ' → ' + posText(r.TOCONTAINER, r.TOPOSITION);
            } else if (r.TOCONTAINER) {
                posChange = posText(r.TOCONTAINER, r.TOPOSITION);
            }
            var src = '';
            if (r.SOURCEORDER) { src = '单据:' + escapeHtml(r.SOURCEORDER); }
            if (r.INBOUNDSOURCE) { src += (src ? ' / ' : '') + '入库来源:' + escapeHtml(r.INBOUNDSOURCE); }
            var destParts = [];
            if (r.OUTTARGET) { destParts.push('出库口:' + escapeHtml(String(r.OUTTARGET))); }
            if (r.OUTMACHINENO !== null && r.OUTMACHINENO !== undefined && r.OUTMACHINENO !== '') { destParts.push('机台:' + escapeHtml(String(r.OUTMACHINENO))); }

            html += '<fieldset class="layui-elem-field layui-field-title" style="margin-top:8px;">'
                + '<legend style="font-size:14px;">' + FormatToDate(r.CREATETIME)
                + '　<b>' + escapeHtml(bizName) + '</b>'
                + (r.TOSTATUS ? '　<span class="layui-badge ' + (STATUS_MAP[r.TOSTATUS] ? STATUS_MAP[r.TOSTATUS].css : 'layui-bg-gray') + '">' + escapeHtml(statusText(r.TOSTATUS)) + '</span>' : '')
                + '</legend>'
                + '<div style="padding:4px 10px;line-height:1.9;font-size:13px;">'
                + (fromTo ? '<div><b>状态变化：</b>' + fromTo + '</div>' : '')
                + (posChange ? '<div><b>盒/槽位：</b>' + posChange + '</div>' : '')
                + (r.FROMITEMCODE !== r.TOITEMCODE && (r.FROMITEMCODE || r.TOITEMCODE)
                    ? '<div><b>规格变化：</b>' + escapeHtml(r.FROMITEMCODE || '-') + ' → ' + escapeHtml(r.TOITEMCODE || '-') + '</div>' : '')
                + (src ? '<div><b>来源单据：</b>' + src + '</div>' : '')
                + (destParts.length ? '<div><b>去向：</b>' + destParts.join(' / ') + '</div>' : '')
                + (r.REMARK ? '<div><b>备注：</b>' + escapeHtml(r.REMARK) + '</div>' : '')
                + '</div></fieldset>';
        }
        return html;
    }

    function escapeHtml(text) {
        return $('<div/>').text(text === null || text === undefined ? '' : String(text)).html();
    }

    function GetQueryString(name) {
        var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)", "i");
        var r = window.location.search.substr(1).match(reg);
        if (r != null) {
            return r[2];
        }
        return null;
    }
</script>
