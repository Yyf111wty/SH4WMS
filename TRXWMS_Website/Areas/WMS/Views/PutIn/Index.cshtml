<body class="layui-body-content">
    <div class="layui-fluid">
        <div class="layui-card">
            <div class="layui-card-header">
                <i class="iconfont">&#xe6ac;</i>入库清单
                <span class="layui-layout-right">
                    <a href="javascript:;" hg-event="fullscreen">
                        <i class="layui-icon layui-icon-screen-full"></i>
                    </a>
                </span>
            </div>
            <div class="layui-card-body">
                <div class="layui-row">
                    <div class="layui-form" lay-filter="example">
                        <div class="layui-form-item">
                            <div class="layui-inline" id="locationcodediv">
                                <select id="searchZONECODE" name="searchZONECODE" readonly></select>
                            </div>
                            <div class="layui-inline">
                                <input type="text" name="searchSOURCEORDER" placeholder="单据编号" class="layui-input">
                            </div>
                            <div class="layui-inline">
                                <input type="text" name="searchCONTAINER" placeholder="载具编号" class="layui-input">
                            </div>
                            <div class="layui-inline">
                                <input type="text" name="searchLOCATIONCODE" placeholder="分配库位" class="layui-input">
                            </div>
                            <div class="layui-inline">
                                <input type="text" name="searchITEMCODE" placeholder="物料编号" class="layui-input">
                            </div>
                            <div class="layui-inline">
                                <input type="text" name="searchLOT" placeholder="批次" class="layui-input">
                            </div>
                            <div class="layui-inline">
                                <select id="searchQUESTFLAG" name="searchQUESTFLAG" readonly="true" placeholder="请求入库标识">
                                    <option value="-10">请求入库标识</option>
                                    <option value="0">未请求</option>
                                    <option value="1">已请求</option>
                                </select>
                            </div>

                            <div class="layui-inline">
                                <select id="searchSTATE" name="searchSTATE" readonly="true" placeholder="状态">
                                    <option value="-10">状态</option>
                                    <option value="0">待执行</option>
                                    <option value="1">正在执行</option>
                                    <option value="2">已完成</option>
                                </select>
                            </div>

                            <div class="layui-inline">
                                <select id="searchENABLED" name="searchENABLED" readonly="true" placeholder="有效标识">
                                    <option value="-10">有效标识</option>
                                    <option value="0">失效</option>
                                    <option value="1">有效</option>
                                </select>
                            </div>

                            <div class="layui-input-inline" style="width:280px;">
                                <input type="text" id="dateRange" class="layui-input" placeholder="请选择时间范围">
                            </div>

                        </div>
                    </div>
                </div>
                <div class="layui-row">
                    <div class="layui-row layui-col-space10">
                        <div class="layui-col-md7">
                            <div class="layui-card-divs" id="group_div">
                            </div>
                        </div>
                        <div class="layui-col-md5">
                            <div class="layui-card-divs" id="group_div1">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="layui-row">
                    <div class="layui-row layui-col-space10">
                        <div class="layui-col-md7">
                            <table class="layui-hide" id="typehead" lay-filter="typehead"></table>
                        </div>
                        <div class="layui-col-md5">

                            <table class="layui-hide" id="typebody" lay-filter="typebody"></table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
