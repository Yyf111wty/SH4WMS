<script src="~/Scripts/formattodata.js"></script>
<script src="~/Scripts/loadgroupformbutton.js"></script>
<script>

    //初始化
    $(function () {
        var pageId = GetQueryString('pageId');
        loadGroupFormButton(pageId);
        //select填充数据
        var searchZONECODE = getSelectData("", "库区");
        $("#searchZONECODE").html(searchZONECODE);
        var user = getUsertData();
        if (user == 'bcp' || user == 'ycl' || user == 'cp' || user == 'lck') {
            $("#locationcodediv").hide();
        }
        searchClick();
    })


    //获取用户名
    function getUsertData() {
        var data;
        $.ajax({
            type: "post",
            url: '/Location/GetUsertData',
            dataType: "json",
            async: false,
            success: function (d) {
                data = d;
            }
        });
        return data;
    }
    //获取select数句
    function getSelectData(code, name) {
        var data;
        $.ajax({
            type: "post",
            url: '/Location/GetSearchSelectListByZone',
            data: { code: code, name: name },
            dataType: "json",
            async: false,
            success: function (d) {
                data = d;
            }
        });
        return data;
    }
    //加载head
    function loadDatagrid(ZONECODE, TARGET, ITEMCODE, LOT, SOURCEORDER, CONTAINER, QUESTFLAG, STATE, ENABLED, startTime, endTime) {
        var tableCols = [[
            { field: 'ID', title: 'ID', align: 'center', width: 200, sort: true, hide: true },
            { field: 'ZONECODE', title: '库区编号', align: 'center', width: 100, sort: true },
            { field: 'SOURCEORDER', title: '单据编号', align: 'center', width: 200, sort: true },
            { field: 'CONTAINER', title: '载具编号', align: 'center', width: 150, sort: true },
            { field: 'TASKTYPE', title: 'TASKTYPE', align: 'center', width: 200, sort: true, hide: true },
            { field: 'CONTAINERTYPE', title: 'CONTAINERTYPE', align: 'center', width: 200, sort: true, hide: true },

            { field: 'LOCATIONCODE', title: '起始地址', align: 'center', width: 150, sort: true },
            { field: 'TARGET', title: '目标地址', align: 'center', width: 150, sort: true },
            //{
            //    field: 'QUESTFLAG', width: 100, title: '请求出库标识', templet: function (d) {
            //        if (d.QUESTFLAG == 1) {
            //            return "<span class='layui-badge layui-bg-green'>已请求</span>";
            //        }
            //        else {
            //            return "<span class='layui-badge layui-bg-red'>未请求</span>";
            //        }
            //    }
            //},
            //{
            //    field: 'QUESTTIME', title: '请求出库时间', align: 'center', width: 200, sort: true, templet:
            //        function (d) {
            //            return FormatToDate(d.QUESTTIME);
            //        }
            //},
            {
                field: 'FINISHTIME', title: '完成出库时间', align: 'center', width: 200, sort: true, templet:
                    function (d) {
                        return FormatToDate(d.FINISHTIME);
                    }
            },
            {
                field: 'STATE', width: 100, title: '状态', templet: function (d) {
                    if (d.STATE == 0) {
                        return "<span class='layui-badge layui-bg-yellow'>待执行</span>";
                    }
                    else if (d.STATE == 1) {
                        return "<span class='layui-badge layui-bg-yellow'>正在执行</span>";
                    }
                    else if (d.STATE == 2) {
                        return "<span class='layui-badge layui-bg-green'>已完成</span>";
                    }
                    else if (d.STATE == 3) {
                        return "<span class='layui-badge layui-bg-blue'>已装盘</span>";
                    }
                    else if (d.STATE == 5) {
                        return "<span class='layui-badge layui-bg-red'>异常结束</span>";
                    }
                    else {
                        return "<span class='layui-badge layui-bg-red'>待执行</span>";
                    }
                }
            },
            { field: 'REMARK', title: '备注', align: 'center', width: 200, sort: true },

            {
                field: 'ENABLED', width: 100, title: '有效标识', templet: function (d) {
                    if (d.ENABLED == 1) {
                        return "<span class='layui-badge layui-bg-green'>有效</span>";
                    }
                    else {
                        return "<span class='layui-badge layui-bg-red'>失效</span>";
                    }
                }
            },

            { field: 'CREATOR', title: '创建人', align: 'center', width: 100, sort: true },
            {
                field: 'CREATETIME', title: '创建时间', align: 'center', width: 200, sort: true, templet:
                    function (d) {
                        return FormatToDate(d.CREATETIME);
                    }
            },
            { field: 'LASTEDITOR', title: '更新人', align: 'center', width: 100, sort: true, hide: true },
            {
                field: 'LASTEDITTIME', title: '更新时间', align: 'center', width: 200, hide: true
            }


        ]
        ];
        var table = hg.table.datatable('typehead', '出库绑定主表', '/WMS/PutOut/GetHeadData',
            {
                TARGET: TARGET,
                ITEMCODE: ITEMCODE,
                LOT: LOT,
                ZONECODE: ZONECODE,
                SOURCEORDER: SOURCEORDER,
                CONTAINER: CONTAINER,

                QUESTFLAG: QUESTFLAG,
                STATE: STATE,
                ENABLED: ENABLED,
                startTime: startTime,
                endTime: endTime,
            }, tableCols, '', true, 'full-255');
        table.onrowclick(function (obj) {
            //var SOURCEORDER = obj.data.SOURCEORDER;
            var ID = obj.data.ID;
            loadbodyDatagrid(ID);
        });
    }
    //加载明细
    function loadbodyDatagrid(ID) {
        var tableCols = [[
            { field: 'ID', title: 'ID', align: 'center', width: 200, sort: true, hide: true },
            //{ field: 'SOURCEORDER', title: '订单编号', align: 'center', width: 200, sort: true },
            //{ field: 'CONTAINER', title: '载具编号', align: 'center', width: 200, sort: true },
            { field: 'ITEMCODE', title: '物料编号', align: 'center', width: 200, sort: true },
            { field: 'LOT', title: '批次', align: 'center', width: 200, sort: true },
            //{ field: 'QTY', title: '数量', align: 'center', width: 200, sort: true },
            { field: 'CREATOR', title: '创建人', align: 'center', width: 100, sort: true },

            {
                field: 'CREATETIME', title: '创建时间', align: 'center', width: 200, sort: true, templet:
                    function (d) {
                        return FormatToDate(d.CREATETIME);
                    }
            }

        ]
        ];
        var table = hg.table.datatable('typebody', '物料绑定明细', '/WMS/PutOut/GetBodyData?ID=' + ID, {}, tableCols, '', true, 'full-255');

    }

    //查询
    function searchClick() {
        layui.use(['form', 'layer', 'jquery', 'laydate'],
            function () {
                $ = layui.jquery;
                var form = layui.form;
                var data = form.val('example');
                var SOURCEORDER = data.searchSOURCEORDER;
                var CONTAINER = data.searchCONTAINER;

                var ZONECODE = data.searchZONECODE;
                var TARGET = data.searchTARGET;
                var ITEMCODE = data.searchITEMCODE;
                var LOT = data.searchLOT;
                // var QUESTFLAG = data.searchQUESTFLAG;
                var STATE = data.searchSTATE;
                var ENABLED = data.searchENABLED;
                var laydate = layui.laydate;
                laydate.render({
                    elem: '#dateRange',
                    type: 'datetime',
                    range: true,
                    format: 'yyyy-MM-dd HH:mm:ss'
                });

                var timeRange = $("#dateRange").val();
                var startTime = "";
                var endTime = "";


                if (timeRange) {

                    var arr = timeRange.split(" - ");

                    startTime = arr[0];

                    endTime = arr[1];

                }
                loadDatagrid(ZONECODE, TARGET, ITEMCODE, LOT, SOURCEORDER, CONTAINER, -10, STATE, ENABLED, startTime, endTime);
                loadbodyDatagrid("");
            })
    }

    //删除
    function delClick() {
        //obj通过行tool删除-lay-event
        var row = hg.table.datatable('typehead', 'getSelected');
        if (row) {
            hg.confirm("确定删除此出库单及明细吗？", function () {
                //row.del(); //只删本地数据
                $.ajax({
                    async: false,
                    type: "POST",
                    url: '/WMS/PutOut/DeleteHead',
                    data: { ID: row.data.ID },
                    dataType: "json",
                    success: function (data) {
                        if (data.result == true) {
                            hg.msg('删除成功！');
                            setTimeout(function () { searchClick(); }, 500);
                        }
                        else {
                            hg.msg('删除失败！');
                        }

                    },
                    error: function (data) {
                        hg.msg('删除失败！');
                    }
                })


            });
        } else {
            hg.msg('请选中一行数据，再操作！');
        }
    }
    //加载按钮
    function loadGroupFormButton(pageId) {
        var MyDiv = document.getElementById("group_div");
        var MyDiv1 = document.getElementById("group_div1");
        $.ajax({
            type: "get",
            url: "/Home/GetPermissionBtn",
            dataType: "json",
            data: { pageId: pageId },
            success: function (result) {
                if (result.length == 0) { return; }
                for (var i = 0; i < result.length; i++) {
                    if (result[i].NodeName == "新增" || result[i].NodeName == "编辑" || result[i].NodeName == "删除" || result[i].NodeName == "查询") {
                        var str = result[i].NodeName;
                        var button = "";
                        if (str.search("新增") != -1) {
                            button = ' <button class="layui-btn layui-btn-sm"    id="' + result[i].KeyName + '" onclick="' + result[i].KeyName + 'Click()"><i  class="layui-icon">&#xe654;</i>' + result[i].NodeName + '</button> ';
                        } else if (str.search("编辑") != -1 || str.search("修改") != -1) {
                            button = ' <button class="layui-btn layui-btn-sm"    id="' + result[i].KeyName + '" onclick="' + result[i].KeyName + 'Click()"><i  class="layui-icon">&#xe642;</i>' + result[i].NodeName + '</button> ';
                        } else if (str.search("删除") != -1) {
                            button = ' <button class="layui-btn layui-btn-sm"    id="' + result[i].KeyName + '" onclick="' + result[i].KeyName + 'Click()"><i  class="layui-icon">&#xe640;</i>' + result[i].NodeName + '</button> ';
                        } else if (str.search("查询") != -1) {
                            button = ' <button class="layui-btn layui-btn-sm"    id="' + result[i].KeyName + '" onclick="' + result[i].KeyName + 'Click()"><i  class="layui-icon">&#xe615;</i>' + result[i].NodeName + '</button> ';
                        } else {
                            button = ' <button class="layui-btn layui-btn-sm"    id="' + result[i].KeyName + '" onclick="' + result[i].KeyName + 'Click()"><i  class="layui-icon">&#xe642;</i>' + result[i].NodeName + '</button> ';
                        }
                        //var button = ' <button class="layui-btn layui-btn-sm"    id="' + result[i].KeyName + '" onclick="' + result[i].KeyName + 'Click()"><i  class="layui-icon">' + result[i].NodeName + '</i></button> ';
                        MyDiv.innerHTML += button;
                    }
                    else {
                        var str = result[i].NodeName;
                        var button = "";
                        if (str.search("新增") != -1) {
                            button = ' <button class="layui-btn layui-btn-sm"    id="' + result[i].KeyName + '" onclick="' + result[i].KeyName + 'Click()"><i  class="layui-icon">&#xe654;</i>' + result[i].NodeName + '</button> ';
                        } else if (str.search("编辑") != -1 || str.search("修改") != -1) {
                            button = ' <button class="layui-btn layui-btn-sm"    id="' + result[i].KeyName + '" onclick="' + result[i].KeyName + 'Click()"><i  class="layui-icon">&#xe642;</i>' + result[i].NodeName + '</button> ';
                        } else if (str.search("删除") != -1) {
                            button = ' <button class="layui-btn layui-btn-sm"    id="' + result[i].KeyName + '" onclick="' + result[i].KeyName + 'Click()"><i  class="layui-icon">&#xe640;</i>' + result[i].NodeName + '</button> ';
                        } else if (str.search("查询") != -1) {
                            button = ' <button class="layui-btn layui-btn-sm"    id="' + result[i].KeyName + '" onclick="' + result[i].KeyName + 'Click()"><i  class="layui-icon">&#xe615;</i>' + result[i].NodeName + '</button> ';
                        } else {
                            button = ' <button class="layui-btn layui-btn-sm"    id="' + result[i].KeyName + '" onclick="' + result[i].KeyName + 'Click()"><i  class="layui-icon">&#xe642;</i>' + result[i].NodeName + '</button> ';
                        }
                        // var button = ' <button class="layui-btn layui-btn-sm"    id="' + result[i].KeyName + '" onclick="' + result[i].KeyName + 'Click()"><i  class="layui-icon">' + result[i].NodeName + '</i></button> ';
                        MyDiv1.innerHTML += button;
                    }
                }
            },
            error: function (message) {
                //$.messageBox('系统提示', message); return;
                layer.alert(message, { icon: 6 }); return;

            }
        })
    }
    //获取参数
    function GetQueryString(name) {
        var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)", "i");
        var r = window.location.search.substr(1).match(reg);
        if (r != null)
            return (r[2]);
        return null;
    }


</script>