
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="UTF-8">
    <title></title>
    <meta name="renderer" content="webkit|ie-comp|ie-stand">
    <meta http-equiv="hg-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width,minimum-scale=1.0,maximum-scale=1.0,user-scalable=no">
    <meta http-equiv="Cache-Control" content="no-siteapp" />
    <link rel="stylesheet" href="~/css/font.css">
    <link rel="stylesheet" href="~/lib/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/lib/admin/admin.css" media="all">
    <link rel="stylesheet" href="~/lib/Scrollbar/jquery.scrollbar.css">
    <script type="text/javascript" src="~/lib/admin/jquery-1.9.1.min.js"></script>
    <script type="text/javascript" src="~/lib/Scrollbar/jquery.scrollBar.js"></script>
    <script type="text/javascript" src="~/lib/layui/layui.js"></script>
    <script type="text/javascript" src="~/lib/admin/admin.js"></script>
</head>

<body class="layui-body-content">
    <div class="layui-fluid">
        <div class="layui-card">
            <div class="layui-card-header">
                <i class="iconfont">&#xe6ac;</i>库区信息
                <span class="layui-layout-right">
                    <a href="javascript:;" hg-event="fullscreen">
                        <i class="layui-icon layui-icon-screen-full"></i>
                    </a>
                </span>
            </div>
            <div class="layui-card-body">
                <div class="layui-form" lay-filter="example">
                    <div class="layui-form-item">

                        <div class="layui-inline">
                            <input type="text" name="searchproductname" placeholder="库区编号" class="layui-input">
                        </div>

                    </div>
                </div>
                <div class="layui-card-divs" id="group_div">
                </div>
                <table class="layui-hide" id="product" lay-filter="product"></table>
            </div>
        </div>
        <div class="layui-floor">
            <blockquote class="layui-elem-quote layui-quote-nm">
                Copyright @@ks-jichen.com  2026-2027 All Rights Reserved.
            </blockquote>
        </div>
    </div>

</body>
</html>
<script src="~/Scripts/formattodata.js"></script>
<script src="~/Scripts/loadgroupformbutton.js"></script>
<script>
    //初始化
    $(function () {
        var pageId = GetQueryString('pageId');
        loadGroupFormButton(pageId);
        loadDatagrid("");

    })

    //基本设置
    function loadDatagrid(productname) {
        var tableCols = [[

            { field: 'ID', title: 'ID', align: 'center', width: 200, sort: true, hide: true },
            {
                field: 'WAREHOUSECODE', title: '仓库编号', align: 'center', width: 200, sort: true
            },
            { field: 'ZONECODE', title: '库区编号', align: 'center', width: 150, sort: true },
            { field: 'ZONENAME', title: '库区名称', align: 'center', width: 200, sort: true },
            { field: 'OUTENTRANCE', title: '出库口', align: 'center', width: 200, sort: true },
            { field: 'INENTRANCE', title: '入库口', align: 'center', width: 200, sort: true },
            {
                field: 'ENABLED', width: 100, title: '有效标识', templet: function (d) {
                    if (d.ENABLED == 1) {
                        return "<span class='layui-badge layui-bg-green'>有效</span>";
                    }
                    else {
                        return "<span class='layui-badge layui-bg-red'>失效</span>";
                    }
                }
            },
            { field: 'CREATOR', title: '创建人', align: 'center', width: 100, sort: true },
            {
                field: 'CREATETIME', title: '创建时间', align: 'center', width: 200, sort: true, templet:
                    function (d) {
                        return FormatToDate(d.CREATETIME);
                    }
            },
            { field: 'LASTEDITOR', title: '更新人', align: 'center', width: 100, sort: true },
            {
                field: 'LASTEDITTIME', title: '更新时间', align: 'center', width: 200, sort: true, templet:
                    function (d) {
                        return FormatToDate(d.LASTEDITTIME);
                    }
            },

        ]
        ];
        hg.table.datatable('product', '库区管理', '/WMS/Zone/GetRowData?CODE=' + productname, {}, tableCols, '', true, 'full-255');
    }
    //查询
    function searchClick() {
        layui.use(['form', 'layer', 'jquery'],
            function () {
                $ = layui.jquery;
                var form = layui.form;
                var data = form.val('example');
                var searchproductname = data.searchproductname;

                loadDatagrid(searchproductname);
            })
    }
    //新增
    function addClick() {

        var token = getCurrentToken();
        var url = '/WMS/Zone/AddOrEdit?typeflag=0';
        if (token) url += '&token=' + token;

        hg.open('新增', url, 500, 500);
    }
    //修改
    function editClick() {
        //obj通过行tool修改-lay-event
        var row = hg.table.datatable('product', 'getSelected');
        if (row) {
            var token = getCurrentToken();
            var datas =
                "&ID=" + row.data.ID +
                "&ZONECODE=" + row.data.ZONECODE +
                "&ZONENAME=" + row.data.ZONENAME +
                "&WAREHOUSECODE=" + row.data.WAREHOUSECODE +
                "&OUTENTRANCE=" + row.data.OUTENTRANCE +
                "&INENTRANCE=" + row.data.INENTRANCE +
                "&ENABLED=" + row.data.ENABLED
                ;

            var url = '/WMS/Zone/AddOrEdit?typeflag=1' + datas;
            if (token) url += '&token=' + token;

            hg.open('编辑', url, 500, 500);
        } else {
            hg.msg('请选中一行数据，再操作！');
        }
    }

    //失效
    function delClick() {
        //obj通过行tool删除-lay-event
        var row = hg.table.datatable('product', 'getSelected');
        if (row) {
            hg.confirm("确定删除此库位吗？", function () {
                //row.del(); //只删本地数据
                $.ajax({
                    async: false,
                    type: "POST",
                    url: '/WMS/Zone/DeleteProduct',
                    data: { ID: row.data.ID },
                    dataType: "json",
                    success: function (data) {
                        if (data.result == true) {
                            hg.msg('删除成功！');
                            setTimeout(function () { searchClick(); }, 500);
                        }
                        else {
                            hg.msg('删除失败！');
                        }

                    },
                    error: function (data) {
                        hg.msg('删除失败！');
                    }
                })


            });
        } else {
            hg.msg('请选中一行数据，再操作！');
        }
    }

    //获取参数
    function GetQueryString(name) {
        var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)", "i");
        var r = window.location.search.substr(1).match(reg);
        if (r != null)
            return (r[2]);
        return null;
    }

</script>
