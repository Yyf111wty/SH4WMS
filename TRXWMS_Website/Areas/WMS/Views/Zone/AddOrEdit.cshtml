
@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>
    <meta charset="UTF-8">
    <title></title>
    <meta name="renderer" content="webkit|ie-comp|ie-stand">
    <meta http-equiv="hg-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width,minimum-scale=1.0,maximum-scale=1.0,user-scalable=no">
    <meta http-equiv="Cache-Control" content="no-siteapp" />
    <link rel="stylesheet" href="~/css/font.css">
    <link rel="stylesheet" href="~/lib/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/lib/admin/admin.css" media="all">
    <link rel="stylesheet" href="~/lib/Scrollbar/jquery.scrollbar.css">
    <script type="text/javascript" src="~/lib/admin/jquery-1.9.1.min.js"></script>
    <script type="text/javascript" src="~/lib/Scrollbar/jquery.scrollBar.js"></script>
    <script type="text/javascript" src="~/lib/layui/layui.js"></script>
    <script type="text/javascript" src="~/lib/admin/admin.js"></script>
    <!-- 让IE8/9支持媒体查询，从而兼容栅格 -->
    <!--[if lt IE 9]>
            <script src="https://cdn.staticfile.org/html5shiv/r29/html5.min.js"></script>
            <script src="https://cdn.staticfile.org/respond.js/1.4.2/respond.min.js"></script>
        <![endif]-->
</head>

<body class="layui-body-content">
    <div class="layui-fluid">
        <div class="layui-row">
            <form class="layui-form" action="" lay-filter="example">

                <div class="layui-form-item">
                    <label class="layui-form-label">
                        库区编号<label style="color:red"> *</label>
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="ZONECODE" name="ZONECODE" class="layui-input" lay-verify="required">
                        <input type="hidden" id="typeflag" name="typeflag" class="layui-input">
                        <input type="hidden" id="ID" name="ID" class="layui-input">
                    </div>
                </div>

                <div class="layui-form-item">
                    <label class="layui-form-label">
                        库区名称<label style="color:red"> *</label>
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="ZONENAME" name="ZONENAME" class="layui-input" lay-verify="required">
                    </div>
                </div>

                <div class="layui-form-item">
                    <label class="layui-form-label">
                        仓库编号<label style="color:red"> *</label>
                    </label>
                    <div class="layui-input-block">
                        <select id="WAREHOUSECODE" name="WAREHOUSECODE" readonly lay-verify="required"></select>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">
                        出库口<label style="color:red"> *</label>
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="OUTENTRANCE" name="OUTENTRANCE" class="layui-input" lay-verify="required">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">
                        入库口<label style="color:red"> *</label>
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="INENTRANCE" name="INENTRANCE" class="layui-input" lay-verify="required">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">
                        激活标识<label style="color:red"> *</label>
                    </label>
                    <div class="layui-input-block">
                        <input type="checkbox" id="ENABLED" name="ENABLED" class="layui-input" lay-verify="required" lay-skin="switch" lay-text="有效|失效">
                    </div>
                </div>

                <div class="layui-form-item">
                    <label for="L_repass" class="layui-form-label"></label>
                    <button class="layui-btn" lay-filter="add" lay-submit="">确定</button>
                    <button class="layui-btn" onclick="cancelclick()">取消</button>
                </div>
            </form>
        </div>
    </div>
</body>

</html>
<script src="~/Scripts/formattodata.js"></script>
<script src="~/Scripts/loadgroupformbutton.js?v=20261119"></script>

<script>

    //组件初始化
    layui.use(['form', 'layer', 'jquery'],
        function () {
            $ = layui.jquery;
            var form = layui.form;
            var typeflag = GetQueryString('typeflag');
            //select填充数据
            var wareData = getSelectWarehouseData("warehouse", "仓库列表");
            $("#WAREHOUSECODE").html(wareData);

            //自定义验证规则
            form.verify({
                //prod_name: [/(.+){1,50}$/, '产品名称不能为空且最多只能输入50个字符'],
            }
            );

            //初始化控件
            if (typeflag == 0) {
                form.val('example', {
                    "ID": ""
                    , "ZONECODE": ""
                    , "ZONENAME": ""
                    , "WAREHOUSECODE": ""
                    , "OUTENTRANCE": ""
                    , "INENTRANCE": ""
                    , "ENABLED": ""
                    , "typeflag": typeflag
                });
                $("input[name='ENABLED']").attr("checked", "checked");
                form.render();
            }
            else {
                var ID = GetQueryString('ID');
                var ZONECODE = GetQueryString('ZONECODE');
                var ZONENAME = GetQueryString('ZONENAME');
                var WAREHOUSECODE = GetQueryString('WAREHOUSECODE');
                var OUTENTRANCE = GetQueryString('OUTENTRANCE');
                var INENTRANCE = GetQueryString('INENTRANCE');
                var ENABLED = GetQueryString('ENABLED');
                var CREATOR = GetQueryString('CREATOR');
                var CREATETIME = GetQueryString('CREATETIME');
                var LASTEDITOR = GetQueryString('LASTEDITOR');
                var LASTEDITTIME = GetQueryString('LASTEDITTIME');
                //var machine_status = GetQueryString('machine_status');
                form.val('example', {
                    "ID": ID
                    , "ZONECODE": ZONECODE
                    , "ZONENAME": ZONENAME
                    , "WAREHOUSECODE": WAREHOUSECODE
                    , "OUTENTRANCE": OUTENTRANCE
                    , "INENTRANCE": INENTRANCE
                    , "ENABLED": ENABLED
                    , "typeflag": typeflag
                });
                if (ENABLED == 1) {
                    $("input[name='ENABLED']").attr("checked", "checked");
                } else {
                    $("input[name='ENABLED']").removeAttr("checked");
                }
                form.render();

            }
            //监听提交
            form.on('submit(add)',
                function (data) {
                    saveAction(data);
                    return false;
                });

        });

    //绑定取消按钮操作
    function cancelclick() {
        //var index = parent.layer.index; //获取当前弹层的索引号
        //parent.layer.close(index); //关闭当前弹层
        hg.close();
    }
    function getToken() {
        return GetQueryString("token");
    }

    //
    //保存、编辑操作
    function saveAction(data) {
        var ENABLED = 1;
        if (typeof (data.field.ENABLED) == "undefined") {
            ENABLED = 0;
        }
        if (data.field.typeflag == "0") {
            $.ajax({
                type: "POST",
                url: '/WMS/Zone/AddProduct',
                headers: {
                    "Authorization": "Bearer " + getToken()  // ✅ 修复
                },
                data: {
                    ZONECODE: data.field.ZONECODE,
                    ZONENAME: data.field.ZONENAME,
                    WAREHOUSECODE: data.field.WAREHOUSECODE,
                    OUTENTRANCE: data.field.OUTENTRANCE,
                    INENTRANCE: data.field.INENTRANCE,
                    ENABLED: ENABLED
                },
                dataType: "json",
                success: function (data) {
                    if (data.result == true) {
                        hg.msghide("保存成功"); // ✅ 使用框架支持的提示
                        // ✅ 再关闭弹窗
                        setTimeout(function () {
                            hg.close();
                        }, 500);
                        // ✅ 先刷新父页面
                        parent.searchClick();
                    }
                    else {
                        hg.msg("添加失败:" + data.result);
                        return false;
                    }

                },
                error: function (data) {
                    hg.msg("添加失败:" + data.result);
                    return false;
                }
            })
        } else {
            $.ajax({
                type: "POST",
                url: '/WMS/Zone/EditProduct',
                headers: {
                    "Authorization": "Bearer " + getToken()  // ✅ 修复
                },
                data: {
                    ID: data.field.ID,
                    ZONECODE: data.field.ZONECODE,
                    ZONENAME: data.field.ZONENAME,
                    WAREHOUSECODE: data.field.WAREHOUSECODE,
                    OUTENTRANCE: data.field.OUTENTRANCE,
                    INENTRANCE: data.field.INENTRANCE,
                    ENABLED: ENABLED
                },
                dataType: "json",
                success: function (data) {
                    if (data.result == true) {
                        hg.msghide("保存成功"); // ✅ 使用框架支持的提示
                        // ✅ 再关闭弹窗
                        setTimeout(function () {
                            hg.close();
                        }, 500);
                        // ✅ 先刷新父页面
                        parent.searchClick();
                    }
                    else {
                        hg.msghide("操作失败");
                        return false;
                    }

                },
                error: function (data) {
                    hg.msghide("操作失败");
                    return false;
                }
            })
        }


    }
    //获取传过来的值
    function GetQueryString(name) {
        var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)", "i");
        var r = window.location.search.substr(1).match(reg);
        if (r != null)
            return decodeURI(r[2]);
        return null;
    }

    //获取select数句
    function getSelectWarehouseData(code, name) {
        var data;
        $.ajax({
            type: "post",
            url: '/WMS/Zone/GetSearchSelectListByWarehouse',
            data: { code: code, name: name },
            dataType: "json",
            async: false,
            success: function (d) {
                data = d;
            }
        });
        return data;
    }

</script>
