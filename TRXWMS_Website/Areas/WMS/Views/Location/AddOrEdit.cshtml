
@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>
    <meta charset="UTF-8">
    <title></title>
    <meta name="renderer" content="webkit|ie-comp|ie-stand">
    <meta http-equiv="hg-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width,minimum-scale=1.0,maximum-scale=1.0,user-scalable=no">
    <meta http-equiv="Cache-Control" content="no-siteapp" />
    <link rel="stylesheet" href="~/css/font.css">
    <link rel="stylesheet" href="~/lib/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/lib/admin/admin.css" media="all">
    <link rel="stylesheet" href="~/lib/Scrollbar/jquery.scrollbar.css">
    <script type="text/javascript" src="~/lib/admin/jquery-1.9.1.min.js"></script>
    <script type="text/javascript" src="~/lib/Scrollbar/jquery.scrollBar.js"></script>
    <script type="text/javascript" src="~/lib/layui/layui.js"></script>
    <script type="text/javascript" src="~/lib/admin/admin.js"></script>
    <!-- 让IE8/9支持媒体查询，从而兼容栅格 -->
    <!--[if lt IE 9]>
            <script src="https://cdn.staticfile.org/html5shiv/r29/html5.min.js"></script>
            <script src="https://cdn.staticfile.org/respond.js/1.4.2/respond.min.js"></script>
        <![endif]-->
</head>

<body class="layui-body-content">
    <div class="layui-fluid">
        <div class="layui-row">
            <form class="layui-form" action="" lay-filter="example">


                <div class="layui-form-item">
                    <label class="layui-form-label">
                        库区编号<label style="color:red"> *</label>
                    </label>
                    <div class="layui-input-block">
                        <select id="ZONECODE" name="ZONECODE" readonly lay-verify="required"></select>
                    </div>
                </div>

                <div class="layui-form-item">
                    <label class="layui-form-label">
                        货位编码<label style="color:red"> *</label>
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="LOCATIONCODE" name="LOCATIONCODE" class="layui-input" lay-verify="required">
                        <input type="hidden" id="typeflag" name="typeflag" class="layui-input">
                        <input type="hidden" id="ID" name="ID" class="layui-input">
                    </div>
                </div>

                <div class="layui-form-item">
                    <label class="layui-form-label">
                        库位类型<label style="color:red"> *</label>
                    </label>
                    <div class="layui-input-block">
                        <select id="TYPE" name="TYPE" lay-verify="required">
                            <option value="">请选择</option>
                            <option value="ST">存储位</option>
                            <option value="CT">其他</option>
                        </select>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">
                        载具编号
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="CONTAINER" name="CONTAINER" class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">
                        托盘类型
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="CONTAINERTYPE" name="CONTAINERTYPE" class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">
                        单据编号
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="SOURCEORDER" name="SOURCEORDER" class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">
                        巷道编号<label style="color:red"> *</label>
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="TUNNELNUM" name="TUNNELNUM" class="layui-input" lay-verify="number">
                    </div>
                </div>

                <div class="layui-form-item">
                    <label class="layui-form-label">
                        货位限高<label style="color:red"> *</label>
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="LIMITHEIGHT" name="LIMITHEIGHT" class="layui-input" lay-verify="number">
                    </div>
                </div>

                @*<div class="layui-form-item">
                        <label class="layui-form-label">
                            货位限重<label style="color:red"> *</label>
                        </label>
                        <div class="layui-input-block">
                            <input type="text" id="LIMITWEIGHT" name="LIMITWEIGHT" class="layui-input" lay-verify="number">
                        </div>
                    </div>*@




                @*<div class="layui-form-item">
                        <label class="layui-form-label">
                            分组标识
                        </label>
                        <div class="layui-input-block">
                            <input type="text" id="SORTTYPE" name="SORTTYPE" class="layui-input">
                        </div>
                    </div>*@

                @*<div class="layui-form-item">
                        <label class="layui-form-label">
                            远近伸位标识<label style="color:red"> *</label>
                        </label>
                        <div class="layui-input-block">
                            <input type="text" id="EXITOROUT" name="EXITOROUT" class="layui-input" lay-verify="number">
                        </div>
                    </div>*@




                <div class="layui-form-item">
                    <label class="layui-form-label">
                        激活标识<label style="color:red"> *</label>
                    </label>
                    <div class="layui-input-block">
                        <input type="checkbox" name="ENABLED" lay-filter="ENABLED" lay-skin="switch" lay-text="有效|失效">
                    </div>
                </div>

                <div class="layui-form-item">
                    <label class="layui-form-label">
                        可出入库标识<label style="color:red"> *</label>
                    </label>
                    <div class="layui-input-block">
                        <input type="checkbox" name="ISAVIALABLE" lay-filter="ISAVIALABLE" lay-skin="switch" lay-text="允许|不允许">
                    </div>
                </div>

                <div class="layui-form-item">
                    <label class="layui-form-label">
                        备注信息
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="REMARK" name="REMARK" class="layui-input">
                    </div>
                </div>


                <div class="layui-form-item">
                    <label for="L_repass" class="layui-form-label"></label>
                    <button class="layui-btn" lay-filter="add" lay-submit="">确定</button>
                    <button class="layui-btn" onclick="cancelclick()">取消</button>
                </div>
            </form>
        </div>
    </div>
</body>

</html>
<script>

    //组件初始化
    layui.use(['form', 'layer', 'jquery'],
        function () {
            $ = layui.jquery;
            var form = layui.form;
            var typeflag = GetQueryString('typeflag');
            //select填充数据
            //var wareData = getSelectWarehouseData("warehouse", "选择仓库");
            var zoneData = getSelectZoneData("zone", "选择库区");

            $("#ZONECODE").html(zoneData);

            //自定义验证规则
            form.verify({
                //prod_name: [/(.+){1,50}$/, '产品名称不能为空且最多只能输入50个字符'],
            }
            );
            //var IDD = GetQueryString('ID');
            //var WAREHOUSECODEd = GetQueryString('WAREHOUSECODE');

            //初始化控件
            if (typeflag == 0) {
                form.val('example', {
                    "ID": ""
                    , "ZONECODE": ""
                    , "LOCATIONCODE": ""
                    , "TYPE": ""

                    , "TUNNELNUM": ""
                    , "LIMITHEIGHT": ""

                    , "CONTAINER": ""
                    , "CONTAINERTYPE": ""
                    , "SOURCEORDER": ""
                    , "REMARK": ""
                    , "typeflag": typeflag
                });
                $("#ZONECODE").removeAttr("disabled");
                $("#LOCATIONCODE").removeAttr("disabled");
                $("input[name='ISAVIALABLE']").attr("checked", "checked");
                $("input[name='ENABLED']").attr("checked", "checked");
                form.render();
            }
            else {
                var ID = GetQueryString('ID');

                var ZONECODE = GetQueryString('ZONECODE');
                var LOCATIONCODE = GetQueryString('LOCATIONCODE');
                var TYPE = GetQueryString('TYPE');
                //var ROWNUM = GetQueryString('ROWNUM');
                //var COLUMNNUM = GetQueryString('COLUMNNUM');
                //var LAYERNUM = GetQueryString('LAYERNUM');
                var CONTAINERTYPE = GetQueryString('CONTAINERTYPE');
                var TUNNELNUM = GetQueryString('TUNNELNUM');
                var LIMITHEIGHT = GetQueryString('LIMITHEIGHT');
                var CONTAINER = GetQueryString('CONTAINER');
                var SOURCEORDER = GetQueryString('SOURCEORDER');

                var ENABLED = GetQueryString('ENABLED');
                var ISAVIALABLE = GetQueryString('ISAVIALABLE');
                var REMARK = GetQueryString('REMARK');
                if (REMARK == "null") {
                    REMARK = "";
                }


                form.val('example', {
                    "ID": ID
                    , "ZONECODE": ZONECODE
                    , "LOCATIONCODE": LOCATIONCODE
                    , "TYPE": TYPE

                    , "TUNNELNUM": TUNNELNUM
                    , "LIMITHEIGHT": LIMITHEIGHT

                    , "CONTAINERTYPE": CONTAINERTYPE
                    , "CONTAINER": CONTAINER
                    , "SOURCEORDER": SOURCEORDER

                    , "REMARK": ""
                    , "typeflag": typeflag
                });
                if (ISAVIALABLE == 1) {
                    $("input[name='ISAVIALABLE']").attr("checked", "checked");
                } else {
                    $("input[name='ISAVIALABLE']").removeAttr("checked");
                }
                if (ENABLED == 1) {
                    $("input[name='ENABLED']").attr("checked", "checked");
                } else {
                    $("input[name='ENABLED']").removeAttr("checked");
                }
                $("#ZONECODE").val(ZONECODE);
                $("#TYPE").val(TYPE);
                $("#ZONECODE").attr("disabled", "disabled");
                $("#LOCATIONCODE").attr("disabled", "disabled");
                form.render();

            }
            //监听提交
            form.on('submit(add)',
                function (data) {
                    saveAction(data);

                });

        });

    //绑定取消按钮操作
    function cancelclick() {
        //var index = parent.layer.index; //获取当前弹层的索引号
        //parent.layer.close(index); //关闭当前弹层
        hg.close();
    }

    //
    //保存、编辑操作
    function saveAction(data) {
        var ENABLED = 1;
        if (typeof (data.field.ENABLED) == "undefined") {
            ENABLED = 0;
        }
        var ISAVIALABLE = 1;
        if (typeof (data.field.ISAVIALABLE) == "undefined") {
            ISAVIALABLE = 0;
        }
        if (data.field.typeflag == "0") {
            $.ajax({
                type: "POST",
                url: '/WMS/Location/AddProduct',
                data: {

                    ZONECODE: data.field.ZONECODE,
                    LOCATIONCODE: data.field.LOCATIONCODE,
                    TYPE: data.field.TYPE,

                    TUNNELNUM: data.field.TUNNELNUM,
                    LIMITHEIGHT: data.field.LIMITHEIGHT,

                    ENABLED: ENABLED,
                    ISAVIALABLE: ISAVIALABLE,
                    REMARK: data.field.REMARK,
                    SOURCEORDER: data.field.SOURCEORDER,
                    CONTAINERTYPE: data.field.CONTAINERTYPE,
                    CONTAINER: data.field.CONTAINER
                },
                dataType: "json",
                success: function (data) {
                    if (data.result == true) {
                        hg.msg("添加成功");
                        var index = parent.layer.getFrameIndex(window.name);
                        parent.layui.table.reload('product');//重载父页表格，参数为表格ID
                        parent.layer.close(index);
                    }
                    else {
                        hg.msg("添加失败:" + data.result);
                        return false;
                    }

                },
                error: function (data) {
                    hg.msg("添加失败:" + data.result);
                    return false;
                }
            })
        } else {
            $.ajax({
                type: "POST",
                url: '/WMS/Location/EditProduct',
                data: {
                    ID: data.field.ID,
                    ZONECODE: data.field.ZONECODE,
                    LOCATIONCODE: data.field.LOCATIONCODE,
                    TYPE: data.field.TYPE,

                    TUNNELNUM: data.field.TUNNELNUM,
                    LIMITHEIGHT: data.field.LIMITHEIGHT,

                    ENABLED: ENABLED,
                    ISAVIALABLE: ISAVIALABLE,
                    REMARK: data.field.REMARK,
                    SOURCEORDER: data.field.SOURCEORDER,
                    CONTAINERTYPE: data.field.CONTAINERTYPE,
                    CONTAINER: data.field.CONTAINER
                },
                dataType: "json",
                success: function (data) {
                    if (data.result == true) {
                        hg.msg("修改成功");
                        var index = parent.layer.getFrameIndex(window.name);
                        parent.layui.table.reload('product');//重载父页表格，参数为表格ID
                        parent.layer.close(index);
                    }
                    else {
                        hg.msg("修改失败:" + data.result);
                        return false;
                    }

                },
                error: function (data) {
                    hg.msg("修改失败:" + data.result);
                    return false;
                }
            })
        }


    }
    //获取传过来的值
    function GetQueryString(name) {
        var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)", "i");
        var r = window.location.search.substr(1).match(reg);
        if (r != null)
            return decodeURI(r[2]);
        return null;
    }

    //获取select数句

    function getSelectZoneData(code, name) {
        var data;
        $.ajax({
            type: "post",
            url: '/WMS/Location/GetSearchSelectListByZone',
            data: { code: code, name: name },
            dataType: "json",
            async: false,
            success: function (d) {
                data = d;
            }
        });
        return data;
    }

</script>