
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="UTF-8">
    <title></title>
    <meta name="renderer" content="webkit|ie-comp|ie-stand">
    <meta http-equiv="hg-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width,minimum-scale=1.0,maximum-scale=1.0,user-scalable=no">
    <meta http-equiv="Cache-Control" content="no-siteapp" />
    <link rel="stylesheet" href="~/css/font.css">
    <link rel="stylesheet" href="~/lib/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/lib/admin/admin.css" media="all">
    <link rel="stylesheet" href="~/lib/Scrollbar/jquery.scrollbar.css">
    <script type="text/javascript" src="~/lib/admin/jquery-1.9.1.min.js"></script>
    <script type="text/javascript" src="~/lib/Scrollbar/jquery.scrollBar.js"></script>
    <script type="text/javascript" src="~/lib/layui/layui.js"></script>
    <script type="text/javascript" src="~/lib/admin/admin.js"></script>
</head>

<body class="layui-body-content">
    <div class="layui-fluid">
        <div class="layui-card">
            <div class="layui-card-header">
                <i class="iconfont">&#xe6ac;</i>库位管理
                <span class="layui-layout-right">
                    <a href="javascript:;" hg-event="fullscreen">
                        <i class="layui-icon layui-icon-screen-full"></i>
                    </a>
                </span>
            </div>
            <div class="layui-card-body">
                <div class="layui-form" lay-filter="example">
                    <div class="layui-form-item">

                        <div class="layui-inline" id="locationcodediv">
                            <select id="searchZONECODE" name="searchZONECODE" readonly></select>
                        </div>

                        <div class="layui-inline">
                            <input type="text" name="searchLOCATIONCODE" placeholder="库位编号" class="layui-input">
                        </div>

                        <div class="layui-inline">
                            <select id="searchTYPE" name="searchTYPE" readonly="true" placeholder="库位类型">
                                <option value="">库位类型</option>
                                <option value="ST">存储位</option>
                                <option value="PT">其他</option>
                            </select>
                        </div>
                        <div class="layui-inline">
                            <input type="text" name="searchCONTAINER" placeholder="载具编号" class="layui-input">
                        </div>
                        <div class="layui-inline">
                            <input type="text" name="searchSOURCEORDER" placeholder="单据编号" class="layui-input">
                        </div>
                        <div class="layui-inline">
                            <input type="text" name="searchROWNUM" placeholder="排" class="layui-input">
                        </div>

                        <div class="layui-inline">
                            <input type="text" name="searchCOLUMNNUM" placeholder="列" class="layui-input">
                        </div>

                        <div class="layui-inline">
                            <input type="text" name="searchLAYERNUM" placeholder="层" class="layui-input">
                        </div>

                        <div class="layui-inline">
                            <input type="text" name="searchTUNNELNUM" placeholder="巷道编号" class="layui-input">
                        </div>

                        <div class="layui-inline">
                            <input type="text" name="searchLIMITHEIGHT" placeholder="限高" class="layui-input">
                        </div>

                        <div class="layui-inline">
                            <select id="searchENABLED" name="searchENABLED" readonly="true" placeholder="激活标识">
                                <option value="-10">激活标识</option>
                                <option value="0">未激活</option>
                                <option value="1">已激活</option>
                            </select>
                        </div>

                        <div class="layui-inline">
                            <select id="searchISAVIALABLE" name="searchISAVIALABLE" readonly="true" placeholder="可出入标识">
                                <option value="-10">可出入标识</option>
                                <option value="0">不允许</option>
                                <option value="1">允许</option>
                            </select>
                        </div>
                        <div class="layui-inline">
                            <button class="layui-btn layui-btn-warm" onclick="resetSearch()">清空</button>
                        </div>

                    </div>
                </div>
                <div class="layui-card-divs" id="group_div">
                </div>
                <table class="layui-hide" id="product" lay-filter="product"></table>
            </div>
        </div>
        <div class="layui-floor">
            <blockquote class="layui-elem-quote layui-quote-nm">
                Copyright @@ks-jichen.com  2026-2027 All Rights Reserved.
            </blockquote>
        </div>
    </div>

</body>
</html>
<script src="~/Scripts/formattodata.js"></script>
<script src="~/Scripts/loadgroupformbutton.js?v=20261119"></script>
<script>

    //初始化
    $(function () {
        var pageId = GetQueryString('pageId');
        loadGroupFormButton(pageId);
        //select填充数据
        var searchZONECODE = getSelectData("", "库区");
        $("#searchZONECODE").html(searchZONECODE);
        // loadDatagrid("","","","","","","","","","",-10,-10);
        var user = getUsertData();
        if (user == 'bcp' || user == 'ycl' || user == 'cp' || user == 'lck') {
            $("#locationcodediv").hide();
        }
        searchClick();
    })
    function resetSearch() {

        layui.use(['form'], function () {
            var form = layui.form;

            // 1️⃣ 清空表单
            form.val('example', {
                searchZONECODE: '',
                searchLOCATIONCODE: '',
                searchTYPE: '',
                searchCONTAINER: '',
                searchSOURCEORDER: '',
                searchROWNUM: '',
                searchCOLUMNNUM: '',
                searchLAYERNUM: '',
                searchTUNNELNUM: '',
                searchLIMITHEIGHT: '',
                searchENABLED: '-10',
                searchISAVIALABLE: '-10'
            });

            // 2️⃣ 重新渲染 select（非常重要）
            form.render();

            // 3️⃣ 重新查询
            searchClick();
        });
    }
    //获取select数句
    function getSelectData(code, name) {
        var data;
        $.ajax({
            type: "post",
            url: '/Location/GetSearchSelectListByZone',
            data: { code: code, name: name },
            dataType: "json",
            async: false,
            success: function (d) {
                data = d;
            }
        });
        return data;
    }
    //获取用户名
    function getUsertData() {
        var data;
        $.ajax({
            type: "post",
            url: '/Location/GetUsertData',
            dataType: "json",
            async: false,
            success: function (d) {
                data = d;
            }
        });
        return data;
    }

    //基本设置
    function loadDatagrid(ZONECODE, LOCATIONCODE, TYPE, ROWNUM, COLUMNNUM, LAYERNUM, TUNNELNUM, LIMITHEIGHT, ENABLED, ISAVIALABLE, CONTAINER, SOURCEORDER) {
        var tableCols = [[

            { field: 'ID', title: 'ID', align: 'center', width: 200, sort: true, hide: true },
            { field: 'ZONECODE', title: '库区编号', align: 'center', width: 150, sort: true },

            { field: 'LOCATIONCODE', title: '货位编码', align: 'center', width: 150, sort: true },
            {
                field: 'TYPE', width: 100, title: '货位类型', templet: function (d) {
                    if (d.TYPE == 'ST') {
                        return "<span class='layui-badge layui-bg-green'>存储位</span>";
                    }
                    else {
                        return "<span class='layui-badge layui-bg-blue'>其他</span>";
                    }
                }
            },

            { field: 'CONTAINERTYPE', title: '托盘类型', align: 'center', width: 150, sort: true },
            { field: 'CONTAINER', title: '载具编号', align: 'center', width: 150, sort: true },
            { field: 'SOURCEORDER', title: '单据编号', align: 'center', width: 150, sort: true },
            { field: 'ROWNUM', title: '排', align: 'center', width: 100, sort: true },
            { field: 'COLUMNNUM', title: '列', align: 'center', width: 100, sort: true },
            { field: 'LAYERNUM', title: '层', align: 'center', width: 100, sort: true },
            { field: 'TUNNELNUM', title: '巷道编号', align: 'center', width: 100, sort: true },
            { field: 'LIMITHEIGHT', title: '货位限高', align: 'center', width: 100, sort: true },

            {
                field: 'ENABLED', title: '激活标识', width: 200, templet: function (d) {
                    if (d.ENABLED == 1) {
                        return "<span class='layui-badge layui-bg-green'>已激活</span>";
                    }
                    else {
                        return "<span class='layui-badge layui-bg-red'>未激活</span>";
                    }
                }
            },
            {
                field: 'ISAVIALABLE', title: '入库标识', templet: function (d) {
                    if (d.ISAVIALABLE == 1) {
                        return "<span class='layui-badge layui-bg-green'>允许</span>";
                    }
                    else {
                        return "<span class='layui-badge layui-bg-red'>不允许</span>";
                    }
                }
            },
            {
                field: 'OUTENABLED', title: '占用状态', align: 'center', width: 120, sort: true, templet: function (d) {
                    var hasContainer = d.CONTAINER != null
                        && String(d.CONTAINER).trim() !== '';
                    if (hasContainer) {
                        return "<span class='layui-badge layui-bg-red'>占用</span>";
                    }
                    return "<span class='layui-badge layui-bg-green'>可用</span>";
                }
            },
            { field: 'REMARK', title: '备注信息', align: 'center', width: 200, sort: true },
            { field: 'CREATOR', title: '创建人', align: 'center', width: 100, sort: true },
            {
                field: 'CREATETIME', title: '创建时间', align: 'center', width: 200, sort: true, templet:
                    function (d) {
                        return FormatToDate(d.CREATETIME);
                    }
            },
            { field: 'LASTEDITOR', title: '编辑人', align: 'center', width: 100, sort: true },
            {
                field: 'LASTEDITTIME', title: '编辑时间', align: 'center', width: 200, sort: true, templet:
                    function (d) {
                        return FormatToDate(d.LASTEDITTIME);
                    }
            },

        ]
        ];
        hg.table.datatable('product', '库位管理', '/WMS/Location/GetRowData',
            {

                ZONECODE: ZONECODE,
                LOCATIONCODE: LOCATIONCODE,
                TYPE: TYPE,
                ROWNUM: ROWNUM,
                COLUMNNUM: COLUMNNUM,
                LAYERNUM: LAYERNUM,
                TUNNELNUM: TUNNELNUM,
                LIMITHEIGHT: LIMITHEIGHT,
                CONTAINER: CONTAINER,
                SOURCEORDER: SOURCEORDER,
                ENABLED: ENABLED,
                ISAVIALABLE: ISAVIALABLE,
            },
            tableCols, '', true, 'full-255');
    }
    //查询
    function searchClick() {
        layui.use(['form', 'layer', 'jquery'],
            function () {
                $ = layui.jquery;
                var form = layui.form;
                var data = form.val('example');
                var ZONECODE = data.searchZONECODE;
                var LOCATIONCODE = data.searchLOCATIONCODE;
                var TYPE = data.searchTYPE;
                var ROWNUM = data.searchROWNUM;
                var COLUMNNUM = data.searchCOLUMNNUM;
                var LAYERNUM = data.searchLAYERNUM;
                var TUNNELNUM = data.searchTUNNELNUM;
                var LIMITHEIGHT = data.searchLIMITHEIGHT;
                var CONTAINER = data.searchCONTAINER;
                var SOURCEORDER = data.searchSOURCEORDER;
                var ENABLED = data.searchENABLED;
                var ISAVIALABLE = data.searchISAVIALABLE;
                loadDatagrid(ZONECODE, LOCATIONCODE, TYPE, ROWNUM, COLUMNNUM, LAYERNUM, TUNNELNUM, LIMITHEIGHT, ENABLED, ISAVIALABLE, CONTAINER, SOURCEORDER);
            })
    }
    //新增
    function addClick() {
        hg.open('新增', '/WMS/Location/AddOrEdit?typeflag=0', 500, 750);
    }

    //修改
    function editClick() {
        //obj通过行tool修改-lay-event
        var row = hg.table.datatable('product', 'getSelected');
        if (row) {
            var datas =
                "&ID=" + row.data.ID +
                "&ZONECODE=" + row.data.ZONECODE +
                "&LOCATIONCODE=" + row.data.LOCATIONCODE +
                "&SOURCEORDER=" + row.data.SOURCEORDER +
                "&CONTAINER=" + row.data.CONTAINER +
                "&CONTAINERTYPE=" + row.data.CONTAINERTYPE +
                "&TYPE=" + row.data.TYPE +
                //"&ROWNUM=" + row.data.ROWNUM +
                //"&COLUMNNUM=" + row.data.COLUMNNUM +
                //"&LAYERNUM=" + row.data.LAYERNUM +
                "&TUNNELNUM=" + row.data.TUNNELNUM +
                "&LIMITHEIGHT=" + row.data.LIMITHEIGHT +

                "&ENABLED=" + row.data.ENABLED +
                "&ISAVIALABLE=" + row.data.ISAVIALABLE +
                "&REMARK=" + row.data.REMARK
                //"&CREATOR=" + row.data.CREATOR +
                //"&CREATETIME=" + row.data.CREATETIME +
                //"&LASTEDITOR=" + row.data.LASTEDITOR +
                //"&LASTEDITTIME=" + row.data.LASTEDITTIME
                ;
            hg.open('编辑', '/WMS/Location/AddOrEdit?typeflag=1' + datas, 500, 400);
        } else {
            hg.msg('请选中一行数据，再操作！');
        }
    }

    //删除
    function delClick() {
        //obj通过行tool删除-lay-event
        var row = hg.table.datatable('product', 'getSelected');
        if (row) {
            hg.confirm("确定删除此库位吗？", function () {
                //row.del(); //只删本地数据
                $.ajax({
                    async: false,
                    type: "POST",
                    url: '/WMS/Location/DeleteProduct',
                    data: { ID: row.data.ID },
                    dataType: "json",
                    success: function (data) {
                        if (data.result == true) {
                            hg.msg('删除成功！');
                            setTimeout(function () { searchClick(); }, 500);
                        }
                        else {
                            hg.msg('删除失败！');
                        }

                    },
                    error: function (data) {
                        hg.msg('删除失败！');
                    }
                })


            });
        } else {
            hg.msg('请选中一行数据，再操作！');
        }
    }


    //冻结库位
    function djlocationClick() {
        //obj通过行tool删除-lay-event
        var row = hg.table.datatable('product', 'getSelected');
        if (row) {
            if (row.data.ENABLED == 0 & row.data.ISAVIALABLE == 0) {
                hg.msg('此库位已处于冻结状态，请勿重复操作！');
                return false;
            }
            if (row.data.CONTAINER != '') {
                hg.msg('库位为非空状态，请查看实际库位状态，清空库位再重试！');
                return false;
            }
            if (row.data.ENABLED == 1 & row.data.ISAVIALABLE == 0) {
                hg.msg('库位已被占用，请重新选择冻结库位！');
                return false;
            }
            hg.confirm("确定要冻结此库位，冻结后此库位将不再参与出入库管理吗？", function () {
                //row.del(); //只删本地数据
                $.ajax({
                    async: false,
                    type: "POST",
                    url: '/WMS/Location/DJlocation',
                    data: { ID: row.data.ID },
                    dataType: "json",
                    success: function (data) {
                        if (data.result == "true") {
                            hg.msg('冻结成功！');
                            setTimeout(function () { searchClick(); }, 500);
                        }
                        else {
                            hg.msg('冻结失败:' + data.result);
                        }

                    },
                    error: function (data) {
                        hg.msg('冻结失败:' + data.result);
                    }
                })


            });
        } else {
            hg.msg('请选中一行数据，再操作！');
        }
    }

    //解封库位
    function jflocationClick() {
        //obj通过行tool删除-lay-event
        var row = hg.table.datatable('product', 'getSelected');
        if (row) {
            if (row.data.ENABLED == 1) {
                hg.msg('此库位非冻结状态，无需解封库位！');
                return false;
            }
            hg.confirm("是否已确认实际该库位为空库位，若已确认则点击确认按钮否则请点击取消按钮？", function () {
                //row.del(); //只删本地数据
                $.ajax({
                    async: false,
                    type: "POST",
                    url: '/WMS/Location/JFlocation',
                    data: { ID: row.data.ID },
                    dataType: "json",
                    success: function (data) {
                        if (data.result == "true") {
                            hg.msg('解封成功！');
                            setTimeout(function () { searchClick(); }, 500);
                        }
                        else {
                            hg.msg('解封失败:' + data.result);
                        }

                    },
                    error: function (data) {
                        hg.msg('解封失败:' + data.result);
                    }
                })


            });
        } else {
            hg.msg('请选中一行数据，再操作！');
        }
    }

    //导出信息
    function exportClick() {
        //var row = hg.table.datatable('process', 'getSelected');

        var ZONECODE = $("#searchZONECODE").val();
        var LOCATIONCODE = $("#searchLOCATIONCODE").val();

        var TYPE = $("#searchTYPE").val();
        var ROWNUM = $("#ROWNUM").val();
        var COLUMNNUM = $("#COLUMNNUM").val();
        var LAYERNUM = $("#searchLAYERNUM").val();
        var TUNNELNUM = $("#searchTUNNELNUM").val();

        var LIMITHEIGHT = $("#searchLIMITHEIGHT").val();
        var CONTAINER = $("#searchCONTAINER").val();
        var SOURCEORDER = $("#searchSOURCEORDER").val();
        var ENABLED = $("#searchENABLED").val();
        var ISAVIALABLE = $("#searchISAVIALABLE").val();

        hg.request('/WMS/Location/GetExportlist?ZONECODE=' + ZONECODE + "&LOCATIONCODE=" + LOCATIONCODE
            + "&TYPE=" + TYPE + "&ROWNUM=" + ROWNUM + "&COLUMNNUM=" + COLUMNNUM
            + "&LAYERNUM=" + LAYERNUM + "&TUNNELNUM=" + TUNNELNUM + "&LIMITHEIGHT=" + LIMITHEIGHT
            + "&CONTAINER=" + CONTAINER + "&SOURCEORDER=" + SOURCEORDER + "&ENABLED=" + ENABLED
            + "&ISAVIALABLE=" + ISAVIALABLE
            , function (data) {
                if (data || data.total > 0) {
                    hg.table.exportfile("product", data.rows);
                }
            });
        //this.location.href = "/MES/StepProcess/Export?process_id=" + row.data.process_id;
    }

    //清空库位
    function clearlocationClick() {
        //obj通过行tool删除-lay-event
        var row = hg.table.datatable('product', 'getSelected');
        if (row.data.ENABLED == 0 & row.data.ISAVIALABLE == 0) {
            hg.msg('此库位处于冻结状态，无需清空库位！');
            return false;
        }

        if (row) {
            hg.confirm("确定清空库位吗？", function () {
                //row.del(); //只删本地数据
                $.ajax({
                    async: false,
                    type: "POST",
                    url: '/WMS/Location/Clearlocation',
                    data: { ID: row.data.ID },
                    dataType: "json",
                    success: function (data) {
                        if (data.result == true) {
                            hg.msg('操作成功！');
                            setTimeout(function () { searchClick(); }, 500);
                        }
                        else {
                            hg.msg((data && data.msg) ? data.msg : '操作失败！');
                        }

                    },
                    error: function (data) {
                        hg.msg('操作失败！');
                    }
                })


            });
        } else {
            hg.msg('请选中一行数据，再操作！');
        }
    }

    //清空托盘物料
    function clearmatterClick() {
        //obj通过行tool删除-lay-event
        var row = hg.table.datatable('product', 'getSelected');
        if (row.data.ENABLED == 0 & row.data.ISAVIALABLE == 0) {
            hg.msg('此库位处于冻结状态，无需清空托盘物料！');
            return false;
        }
        if (row.data.CONTAINER == '') {
            hg.msg('当前库位无托盘，无需操作！');
            return false;
        }
        if (row) {
            hg.confirm("确定清空托盘吗？", function () {
                //row.del(); //只删本地数据
                $.ajax({
                    async: false,
                    type: "POST",
                    url: '/WMS/Location/Clearmatter',
                    data: { ID: row.data.ID },
                    dataType: "json",
                    success: function (data) {
                        if (data.result == true) {
                            hg.msg('操作成功！');
                            setTimeout(function () { searchClick(); }, 500);
                        }
                        else {
                            hg.msg((data && data.msg) ? data.msg : '操作失败！');
                        }

                    },
                    error: function (data) {
                        hg.msg('操作失败！');
                    }
                })


            });
        } else {
            hg.msg('请选中一行数据，再操作！');
        }
    }
    //复位该库位
    function resetmatterClick() {
        var user = getUsertData();
        if (user != 'sap') {
            hg.msg('无操作权限，请联系SAP或使用SAP账户登录！');
            return false;
        }
        //obj通过行tool删除-lay-event
        var row = hg.table.datatable('product', 'getSelected');
        if (row.data.ENABLED == 0 & row.data.ISAVIALABLE == 0) {
            hg.msg('此库位处于冻结状态，不可复位！');
            return false;
        }
        if (row.data.CONTAINER != '') {
            hg.msg('当前库位含有托盘信息，不可复位！');
            return false;
        }
        if (row) {
            hg.confirm("是否确认已删除WCS、WMS该库位的未完成堆垛机任务以及该库位未完成的入库单？", function () {
                //row.del(); //只删本地数据
                $.ajax({
                    async: false,
                    type: "POST",
                    url: '/WMS/Location/Resetlocation',
                    data: { ID: row.data.ID },
                    dataType: "json",
                    success: function (data) {
                        if (data.result == "true") {
                            hg.msg('复位成功！');
                            setTimeout(function () { searchClick(); }, 500);
                        }
                        else {
                            hg.msg('复位失败:' + data.result);
                        }

                    },
                    error: function (data) {
                        hg.msg('复位失败:' + data.result);
                    }
                })


            });
        } else {
            hg.msg('请选中一行数据，再操作！');
        }
    }

    //生成库位
    function abcClick() {
        //obj通过行tool删除-lay-event

        $.ajax({
            async: false,
            type: "POST",
            url: '/WMS/Location/addalllocation',
            dataType: "json",
            success: function (data) {
                if (data.result == 0) {
                    hg.msg('成功！');

                }
                else {
                    hg.msg('失败！');
                }

            },
            error: function (data) {
                hg.msg('失败！');
            }
        })


    }

    //获取参数
    function GetQueryString(name) {
        var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)", "i");
        var r = window.location.search.substr(1).match(reg);
        if (r != null)
            return (r[2]);
        return null;
    }

</script>

