
@{
    Layout = null;
}
<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title></title>
    <meta name="renderer" content="webkit|ie-comp|ie-stand">
    <meta http-equiv="hg-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width,minimum-scale=1.0,maximum-scale=1.0,user-scalable=no">
    <meta http-equiv="Cache-Control" content="no-siteapp" />
    <link rel="stylesheet" href="~/css/font.css">
    <link rel="stylesheet" href="~/lib/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/lib/admin/admin.css" media="all">
    <link rel="stylesheet" href="~/lib/Scrollbar/jquery.scrollbar.css">
    <script type="text/javascript" src="~/lib/admin/jquery-1.9.1.min.js"></script>
    <script type="text/javascript" src="~/lib/Scrollbar/jquery.scrollBar.js"></script>
    <script type="text/javascript" src="~/lib/layui/layui.js"></script>
    <script type="text/javascript" src="~/lib/admin/admin.js"></script>
    <!--[if lt IE 9]>
          <script src="https://cdn.staticfile.org/html5shiv/r29/html5.min.js"></script>
          <script src="https://cdn.staticfile.org/respond.js/1.4.2/respond.min.js"></script>
        <![endif]-->
</head>

<body class="layui-body-content">
    <div class="layui-fluid">
        <div class="layui-card">
            <div class="layui-card-header">
                <i class="iconfont">&#xe6ac;</i>AGV任务
                <span class="layui-layout-right">
                    <a href="javascript:;" hg-event="fullscreen">
                        <i class="layui-icon layui-icon-screen-full"></i>
                    </a>
                </span>
            </div>
            <div class="layui-card-body">
                <div class="layui-form" lay-filter="example">
                    <div class="layui-form-item">

                     
                        <div class="layui-inline">
                            <input type="text" name="searchSOURCEORDER" placeholder="单据编号" class="layui-input">
                        </div>


                        <div class="layui-inline">
                            <input type="text" name="searchCONTAINER" placeholder="载具编号" class="layui-input">
                        </div>

                        <div class="layui-inline">
                            <input type="text" name="searchSTARTTAXI" placeholder="开始位置" class="layui-input">
                        </div>

                        <div class="layui-inline">
                            <input type="text" name="searchENDTAXI" placeholder="结束位置" class="layui-input">
                        </div>

                        <div class="layui-inline">
                            <select id="searchSTATE" name="searchSTATE" readonly="true" placeholder="任务状态">
                                <option value="-10">任务状态</option>
                                <option value="-1">等待执行</option>
                                <option value="0">新建</option>
                                <option value="1">正在执行</option>
                                <option value="2">取消</option>
                                <option value="3">已完成</option>
                            </select>
                        </div>

                    </div>
                </div>
                <div class="layui-card-divs" id="group_div">
                </div>
                <table class="layui-hide" id="AgvTask" lay-filter="AgvTask"></table>
            </div>
        </div>
        <div class="layui-floor">
            <blockquote class="layui-elem-quote layui-quote-nm">
                Copyright @@ks-jichen.com  2026-2027 All Rights Reserved.
            </blockquote>
        </div>
    </div>

</body>
</html>
<script src="~/Scripts/formattodata.js"></script>
<script src="~/Scripts/loadgroupformbutton.js"></script>
<script>
    //初始化
    $(function () {
        var pageId = GetQueryString('pageId');
        loadGroupFormButton(pageId);
        //loadDatagrid("", "", "", "", "", -10);
        searchClick();
    })
    //基本设置
    function loadDatagrid(SOURCEORDER, CONTAINER, STARTTAXI, ENDTAXI, STATE) {
        var tableCols = [[

            { field: 'ID', title: 'ID', align: 'center', width: 200, sort: true, hide: true },
            //{ field: 'BARCODE', title: '条码', align: 'center', width: 150, sort: true },
            { field: 'SOURCEORDER', title: '单据编号', align: 'center', width: 240, sort: true, },
            { field: 'CONTAINER', title: '载具编号', align: 'center', width: 150, sort: true, },
            //{ field: 'TYPE', title: '类型', align: 'center', width: 100, sort: true },
            { field: 'PRIORITY', title: '优先级', align: 'center', width: 100, sort: true },
            { field: 'STARTTAXI', title: '开始位置', align: 'center', width: 100, sort: true },
            { field: 'ENDTAXI', title: '终点位值', align: 'center', width: 100, sort: true, },
            //{ field: 'GROUPCODE', title: '组别', align: 'center', width: 100, sort: true },           
            {
                field: 'STATE', title: '状态', align: 'center', width: 100, sort: true, templet:
                    function (d) {
                        if (d.STATE == 0) {
                            return "<span class='layui-badge layui-bg-gray'>新建</span>"
                        } else if (d.STATE == 1) {
                            return "<span class='layui-badge layui-bg-yellow'>正在执行</span>"

                        } else if (d.STATE == 2) {
                            return "<span class='layui-badge layui-bg-green'>取消</span>"
                        } else if (d.STATE == 3) {
                            return "<span class='layui-badge layui-bg-blue'>已完成</span>"
                        }else if (d.STATE == -1) {
                            return "<span class='layui-badge layui-bg-red'>等待执行</span>"
                        }
                    }
            },
            { field: 'CREATOR', title: '创建人', align: 'center', width: 100, sort: true, },
            {
                field: 'CREATETIME', title: '创建时间', align: 'center', width: 200, sortable: true,
                templet:
                    function (d) {
                        return FormatToDate(d.CREATETIME);
                    }
            },
            { field: 'LASTEDITOR', title: '更新人', align: 'center', width: 100, sort: true, },
            {
                field: 'LASTEDITTIME', title: '更新时间', align: 'center', width: 200, sort: true, templet:
                    function (d) {
                        return FormatToDate(d.LASTEDITTIME);
                    }
            },

        ]
        ];
        // hg.table.datatable('product', '入库测高', '/WMS/Height/GetRowData?SOURCEORDER=' + productname, {}, tableCols, '', true, 'full-255');
        hg.table.datatable('AgvTask', 'AGV任务', '/WMS/AgvTask/GetRowData',
            {
               
                SOURCEORDER: SOURCEORDER,
                CONTAINER: CONTAINER, 
                STARTTAXI: STARTTAXI, 
                ENDTAXI: ENDTAXI, 
                STATE: STATE, 
            },
            tableCols, '', true, 'full-255');
    }

    //查询
    function searchClick() {
        layui.use(['form', 'layer', 'jquery'],
            function () {
               
                
                $ = layui.jquery;
                var form = layui.form;
                var data = form.val('example');
                //var BARCODE = data.searchBARCODE;
                var SOURCEORDER = data.searchSOURCEORDER;
                var CONTAINER = data.searchCONTAINER;
                var STARTTAXI = data.searchSTARTTAXI;
                var ENDTAXI = data.searchENDTAXI;
                var STATE = data.searchSTATE;
                loadDatagrid( SOURCEORDER, CONTAINER, STARTTAXI, ENDTAXI,STATE);
            })
    } 

    function addClick() {
        hg.open('新增', '/WMS/AgvTask/AddOrEdit?typeflag=0', 500, 700);
    }
    //修改
    function editClick() {
        //obj通过行tool修改-lay-event
        var row = hg.table.datatable('AgvTask', 'getSelected');
        if (row) {
            var datas =
                "&ID=" + row.data.ID +
                "&BARCODE=" + row.data.BARCODE +
                "&SOURCEORDER=" + row.data.SOURCEORDER +
                "&WAREHOUSECODE=" + row.data.WAREHOUSECODE +
                "&CONTAINER=" + row.data.CONTAINER +
                "&STARTTAXI=" + row.data.STARTTAXI +
                "&ENDTAXI=" + row.data.ENDTAXI +
                "&ITEMCODE=" + row.data.ITEMCODE +
                "&ITEMNAME=" + row.data.ITEMNAME +
                "&PRIORITY=" + row.data.PRIORITY +
                "&STATE=" + row.data.STATE
                ;
            hg.open('编辑', '/WMS/AgvTask/AddOrEdit?typeflag=1' + datas, 500, 600);
        } else {
            hg.msg('请选中一行数据，再操作！');
        }
    }

    //失效
    function delClick() {
        //obj通过行tool删除-lay-event
        var row = hg.table.datatable('AgvTask', 'getSelected');
        if (row) {
            hg.confirm("确定删除此信息吗？", function () {
                //row.del(); //只删本地数据
                $.ajax({
                    async: false,
                    type: "POST",
                    url: '/WMS/AgvTask/DeleteProduct',
                    data: { ID: row.data.ID },
                    dataType: "json",
                    success: function (data) {
                        if (data.result == true) {
                            hg.msg('删除成功！');
                            setTimeout(function () { searchClick();}, 500);
                        }
                        else {
                            hg.msg('删除失败！');
                        }

                    },
                    error: function (data) {
                        hg.msg('删除失败！');
                    }
                })


            });
        } else {
            hg.msg('请选中一行数据，再操作！');
        }
    }

    //取消
    function cancelClick() {
        //obj通过行tool删除-lay-event
        var row = hg.table.datatable('AgvTask', 'getSelected');
        if (row) {
            hg.confirm("确定向AGC下达取消指令吗？", function () {
                //row.del(); //只删本地数据
                $.ajax({
                    async: false,
                    type: "POST",
                    url: '/WMS/AgvTask/AgvCancel',
                    data: { ID: row.data.ID, SOURCEORDER: row.data.SOURCEORDER, USER: row.data.CREATOR },
                    dataType: "json",
                    success: function (data) {
                        if (data.result == true) {
                            hg.msg(data.message);
                            setTimeout(function () { searchClick(); }, 500);
                        }
                        else {
                            hg.msg(data.message);
                        }

                    },
                    error: function (data) {
                        hg.msg(data.message);
                    }
                })


            });
        } else {
            hg.msg('请选中一行数据，再操作！');
        }
    }
    //获取参数
    function GetQueryString(name) {
        var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)", "i");
        var r = window.location.search.substr(1).match(reg);
        if (r != null)
            return (r[2]);
        return null;
    }


</script>