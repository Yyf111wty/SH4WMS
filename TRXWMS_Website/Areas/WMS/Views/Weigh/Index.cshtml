<script src="~/Scripts/formattodata.js"></script>
<script src="~/Scripts/loadgroupformbutton.js"></script>
<script>
    //初始化
    $(function () {
        var pageId = GetQueryString('pageId');
        loadGroupFormButton(pageId);
        loadDatagrid("","");

    })

    //基本设置
    function loadDatagrid( SOURCEORDER, CONTAINER) {
        var tableCols = [[

            { field: 'ID', title: 'ID', align: 'center', width: 200, sort: true, hide: true },
            //{
            //    field: 'WAREHOUSECODE', title: '仓库编码', align: 'center', width: 150, sort: true, templet:
            //        function (d) {
            //            if (d.WAREHOUSECODE == '1103A') {
            //                return "<span class='layui-badge layui-bg-gray'>托盘库</span>"
            //            } else if (d.WAREHOUSECODE == '1103B') {
            //                return "<span class='layui-badge layui-bg-gray'>料箱半成品库</span>"
            //            } else if (d.WAREHOUSECODE == '1103C') {
            //                return "<span class='layui-badge layui-bg-gray'>料箱成品库</span>"
            //            } else {
            //                return "<span class='layui-badge layui-bg-gray'>未知库区</span>"
            //            }
            //        }
            //},
            { field: 'SOURCEORDER', title: '单据编号', align: 'center', width: 150, sort: true },
            { field: 'CONTAINER', title: '载具编号', align: 'center', width: 150, sort: true },

          
            { field: 'ACTUALWEIGHT', title: '实际重量', align: 'center', width: 100, sort: true },
            {
                field: 'RESULT', width: 100, title: '是否达标', templet: function (d) {
                    if (d.RESULT == 1) {
                        return "<span class='layui-badge layui-bg-green'>达标</span>";
                    }
                    else {
                        return "<span class='layui-badge layui-bg-red'>不达标</span>";
                    }
                }
            },
           
            { field: 'REMARK', title: '备注', align: 'center', width: 200, sort: true },
            { field: 'CREATOR', title: '创建人', align: 'center', width: 100, sort: true },
            {
                field: 'CREATETIME', title: '创建时间', align: 'center', width: 200, sort: true, templet:
                    function (d) {
                        return FormatToDate(d.CREATETIME);
                    }
            },
            { field: 'LASTEDITOR', title: '编辑人', align: 'center', width: 100, sort: true },
            {
                field: 'LASTEDITTIME', title: '编辑时间', align: 'center', width: 200, sort: true, templet:
                    function (d) {
                        return FormatToDate(d.LASTEDITTIME);
                    }
            },

        ]
        ];
        hg.table.datatable('product', '入库测重', '/WMS/Weigh/GetRowData',
            {
               
                SOURCEORDER: SOURCEORDER,
                CONTAINER: CONTAINER
             
            },
        tableCols, '', true, 'full-255');
    }
    //查询
    function searchClick() {
        layui.use(['form', 'layer', 'jquery'],
            function () {
                $ = layui.jquery;
                var form = layui.form;
                var data = form.val('example');
               
                var SOURCEORDER = data.searchSOURCEORDER;
                var CONTAINER = data.searchCONTAINER;
              
                loadDatagrid( SOURCEORDER, CONTAINER);
            })
    }
   
    //获取参数
    function GetQueryString(name) {
        var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)", "i");
        var r = window.location.search.substr(1).match(reg);
        if (r != null)
            return (r[2]);
        return null;
    }

</script>