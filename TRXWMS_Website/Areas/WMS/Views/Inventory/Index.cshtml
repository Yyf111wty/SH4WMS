<script src="~/Scripts/formattodata.js"></script>
<script src="~/Scripts/loadgroupformbutton.js"></script>
<script>
    var inventoryTableInited = false;
    var inventorySearching = false;
    var inventoryTableMode = 'list';
    var inventorySortState = { field: '', type: '' };

    function resetInventoryProductTable() {
        inventoryTableInited = false;
        inventorySortState.field = '';
        inventorySortState.type = '';
        delete hg.table.datatablestatus.product;
        $('.layui-table-view[lay-id="product"]').remove();
        $('#product').addClass('layui-hide');
        layui.use('table', function () {
            var table = layui.table;
            if (table.cache && table.cache.product) {
                delete table.cache.product;
            }
        });
    }

    function initInventoryDateRange() {
        layui.use('laydate', function () {
            var laydate = layui.laydate;
            laydate.render({
                elem: '#dateRange',
                type: 'datetime',
                range: true,
                format: 'yyyy-MM-dd HH:mm:ss'
            });
        });
    }

    function getInventorySearchParams() {
        var form = layui.form;
        var data = form.val('example') || {};
        var timeRange = $("#dateRange").val();
        var startTime = "";
        var endTime = "";

        if (timeRange) {
            var arr = timeRange.split(" - ");
            startTime = arr[0] || "";
            endTime = arr[1] || "";
        }

        return {
            LOCATIONCODE: data.searchLOCATIONCODE,
            LOCATIONSTATUS: data.searchLOCATIONSTATUS,
            CONTAINER: data.searchCONTAINER,
            SOURCEORDER: data.searchSOURCEORDER,
            ROWNUM: data.searchROWNUM,
            COLUMNNUM: data.searchCOLUMNNUM,
            LAYERNUM: data.searchLAYERNUM,
            TUNNELNUM: data.searchTUNNELNUM,
            startTime: startTime,
            endTime: endTime,
            field: inventorySortState.field || '',
            order: inventorySortState.type || ''
        };
    }

    function bindInventoryServerSort() {
        if (window.__inventorySortBound) {
            return;
        }
        window.__inventorySortBound = true;
        layui.use(['table'], function () {
            var table = layui.table;
            table.on('sort(product)', function (obj) {
                if (obj.field === 'LASTEDITTIME') {
                    inventorySortState.field = obj.field;
                    inventorySortState.type = obj.type;
                    var params = getInventorySearchParams();
                    table.reload('product', {
                        initSort: obj,
                        where: params,
                        page: { curr: 1 }
                    });
                    return;
                }

                table.sort('product', {
                    field: obj.field,
                    type: obj.type
                });
            });
        });
    }

    //初始化
    $(function () {
        var pageId = GetQueryString('pageId');
        loadGroupFormButton(pageId);
        initInventoryDateRange();

        var user = getUsertData();
        if (user == 'bcp' || user == 'ycl' || user == 'cp' || user == 'LCK' || user == 'lck') {
            $("#locationcodediv").hide();
        }
        searchClick();

    })
    $("#warningDays").on("change", function () {
        layui.table.reload("product");
    });

    //获取用户名
    function getUsertData() {
        var data;
        $.ajax({
            type: "post",
            url: '/Location/GetUsertData',
            dataType: "json",
            async: false,
            success: function (d) {
                data = d;
            }
        });
        return data;
    }
    //获取select数句
    function getSelectData(code, name) {
        var data;
        $.ajax({
            type: "post",
            url: '/Location/GetSearchSelectListByZone',
            data: { code: code, name: name },
            dataType: "json",
            async: false,
            success: function (d) {
                data = d;
            }
        });
        return data;
    }
    //基本设置
    function loadDatagrid(searchParams) {
        if (inventoryTableMode !== 'list') {
            resetInventoryProductTable();
        }
        inventoryTableMode = 'list';

        if (inventoryTableInited) {
            hg.table.datatable('product', 'reload', searchParams);
            return;
        }

        var tableCols = [[
            { type: 'checkbox', fixed: 'left' },
            { field: 'ZONECODE', title: '库区', align: 'center', sort: true },
            {
                field: 'LOCATIONCODE', title: '库位编号', align: 'center', sort: true
            },
            {
                field: 'LOCATIONSTATUS', title: '库位状态', align: 'center', sort: true, templet: function (d) {
                    if (d.LOCATIONSTATUS == '空库位') {
                        return "<span class='layui-badge layui-bg-blue'>空库位</span>";
                    }
                    else if (d.LOCATIONSTATUS == '空托盘') {
                        return "<span class='layui-badge layui-bg-orange'>空托盘</span>";
                    }
                    else if (d.LOCATIONSTATUS == '有库存') {
                        return "<span class='layui-badge layui-bg-green'>有库存</span>";
                    }
                    else if (d.LOCATIONSTATUS == '冻结站台') {
                        return "<span class='layui-badge layui-bg-red'>冻结站台</span>";
                    }
                    else {
                        return "";
                    }
                }
            },
            { field: 'CONTAINER', title: '载具编号', align: 'center', sort: true },
            { field: 'SOURCEORDER', title: '单据编号', align: 'center', width: 200, sort: true },
            {
                field: 'OUTENABLED', title: '是否占用', align: 'center', sort: true, templet: function (d) {
                    if (d.OUTENABLED == 0 || d.OUTENABLED === '0') {
                        return "<span class='layui-badge layui-bg-red'>\u5360\u7528</span>";
                    }
                    return "<span class='layui-badge layui-bg-green'>\u53ef\u7528</span>";
                }
            },
            {
                field: 'LOCATIONINFO', title: '区域（列/层）', align: 'center', sort: true, templet: function (d) {
                    var column = parseInt(d.COLUMNNUM || 0);
                    //区域
                    var area = Math.floor(column / 8) + 1;
                    //列
                    var col = column % 8;
                    if (col == 0) {
                        col = 8;
                        area = area - 1;
                    }
                    return area + '(' + col + '/' + (d.LAYERNUM || '')+')';
                }
            },
            { field: 'ROWNUM', title: '排', align: 'center', sort: true },
            { field: 'COLUMNNUM', title: '列', align: 'center', sort: true },
            { field: 'LAYERNUM', title: '层', align: 'center', sort: true },
            { field: 'TUNNELNUM', title: '巷道', align: 'center', sort: true },
            {
                field: 'LASTEDITTIME',
                title: '入库时间',
                align: 'center',
                width: 200,
                sort: true,
                templet: function (d) {

                    var time = FormatToDate(d.LASTEDITTIME);
                    if (!time) return "";

                    // 获取用户输入的预警天数，默认为7
                    var warningDays = parseInt($("#warningDays").val()) || 7;

                    var date = new Date(time.replace(/-/g, "/"));
                    var days = (new Date() - date) / (1000 * 60 * 60 * 24);

                    if (days >= warningDays) {
                        return "<span style='color:red;font-weight:bold'>" + time + "</span>";
                    }

                    return time;
                }
            }
            //{
            //    field: 'LASTEDITTIME',
            //    title: '入库时间',
            //    align: 'center',
            //    width: 200,
            //    sort: true,
            //    templet: function (d) {

            //        if (!d.LASTEDITTIME) {
            //            return "";
            //        }

            //        // 转换时间
            //        var date = new Date(d.LASTEDITTIME);
            //        var now = new Date();

            //        // 相差天数
            //        var days = (now - date) / (1000 * 60 * 60 * 24);

            //        var time = FormatToDate(d.LASTEDITTIME);

            //        if (days > 7) {
            //            return "<span style='color:red;font-weight:bold;'>" + time + "</span>";
            //        }

            //        return time;
            //    }
            //}
            //{
            //    field: 'LASTEDITTIME', title: '入库时间', align: 'center', width: 200, sort: true, templet:
            //        function (d) {
            //            return FormatToDate(d.LASTEDITTIME);
            //        }
            //}

        ]
        ];
        inventoryTableInited = true;
        bindInventoryServerSort();
        hg.table.datatable('product', '库存报表', '/WMS/Inventory/Getlist',
            searchParams,
            tableCols, '', true, 'full-255', undefined, undefined, { autoSort: false });

        //var table1 = hg.table.datatable('product', '库存查询', '/WMS/Inventory/GetInventoryList'{
        //        LOCATIONCODE: LOCATIONCODE,
        //        LOCATIONSTATUS: LOCATIONSTATUS,
        //        SOURCEORDER: SOURCEORDER,
        //        CONTAINER: CONTAINER,

        //        ROWNUM: ROWNUM,
        //        COLUMNNUM: COLUMNNUM,
        //        LAYERNUM: LAYERNUM,
        //        TUNNELNUM: TUNNELNUM
        //    },
        //    tableCols, '', true, 'full-255')

    }


    //基本设置
    function loadGGDatagrid(SOURCEORDER) {
        resetInventoryProductTable();
        inventoryTableMode = 'gg';

        var tableCols = [[

            { field: 'ZONECODE', title: '库区', align: 'center', sort: true },

            { field: 'SOURCEORDER', title: '单据编号/规格分类', align: 'center', sort: true },
            { field: 'NUM', title: '库存剩余盒数', align: 'center', sort: true },
            { field: 'OCCUPYNUM', title: '当前占用盒数', align: 'center', sort: true }

        ]
        ];
        inventoryTableInited = true;
        hg.table.datatable('product', '规格统计', '/WMS/Inventory/GetGGlist',
            {
                SOURCEORDER: SOURCEORDER
            },
            tableCols, '', true, 'full-255');
    }

    //查询
    function searchClick() {
        if (inventorySearching) {
            return;
        }
        inventorySearching = true;
        layui.use(['form', 'layer', 'jquery'],
            function () {
                $ = layui.jquery;
                try {
                    loadDatagrid(getInventorySearchParams());
                } finally {
                    setTimeout(function () {
                        inventorySearching = false;
                    }, 300);
                }
            });
    }
    //统计查询
    function searchggClick() {
        layui.use(['form', 'layer', 'jquery'],
            function () {
                $ = layui.jquery;
                var form = layui.form;
                var data = form.val('example');

                var SOURCEORDER = data.searchSOURCEORDER;


                loadGGDatagrid(SOURCEORDER);
            })
    }


    //导出信息
    function exportClick() {
        //var row = hg.table.datatable('process', 'getSelected');
        var ZONECODE = '101';
        var LOCATIONCODE = $("#searchLOCATIONCODE").val();
        var LOCATIONSTATUS = $("#searchLOCATIONSTATUS").val();
        var SOURCEORDER = $("#searchSOURCEORDER").val();
        var CONTAINER = $("#searchCONTAINER").val();
        var ITEMCODE = $("#searchITEMCODE").val();
        var LOT = $("#searchLOT").val();
        var CONTAINERTYPE = '';
        hg.request('/WMS/Inventory/GetExportlist?ZONECODE=' + ZONECODE + "&LOCATIONCODE=" + LOCATIONCODE
            + "&LOCATIONSTATUS=" + LOCATIONSTATUS + "&SOURCEORDER=" + SOURCEORDER + "&CONTAINER=" + CONTAINER
            + "&ITEMCODE=" + ITEMCODE + "&LOT=" + LOT + "&CONTAINERTYPE=" + CONTAINERTYPE

            , function (data) {
                if (data || data.total > 0) {
                    hg.table.exportfile("product", data.rows);
                }
            });
        //this.location.href = "/MES/StepProcess/Export?process_id=" + row.data.process_id;
    }


    //获取参数
    function GetQueryString(name) {
        var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)", "i");
        var r = window.location.search.substr(1).match(reg);
        if (r != null)
            return (r[2]);
        return null;
    }

    function formatCallBoxSkipList(skipped) {
        if (!skipped || !skipped.length) {
            return '';
        }
        return skipped.map(function (item) {
            if (typeof item === 'string') {
                return item;
            }
            var container = item.CONTAINER || item.container || '';
            var locationCode = item.LOCATIONCODE || item.locationCode || '';
            var reason = item.REASON || item.reason || '';
            if (container && locationCode) {
                return container + '(' + locationCode + '):' + reason;
            }
            if (locationCode) {
                return locationCode + ':' + reason;
            }
            return reason;
        }).join('；');
    }

    function callBoxClick() {
        window.__wmsButtonKey = 'btnCallBox';
        window.__wmsButtonName = '一键叫箱';
        layui.use(['table', 'layer', 'form'], function () {
            var table = layui.table;
            var layer = layui.layer;
            var form = layui.form;
            var checkStatus = table.checkStatus('product');
            var rows = checkStatus.data || [];

            if (rows.length === 0) {
                hg.msg('请先勾选需要叫箱的库存记录');
                return;
            }

            var validRows = rows.filter(function (row) {
                return row.LOCATIONSTATUS === '有库存' && row.CONTAINER;
            });

            if (validRows.length === 0) {
                hg.msg('所选记录中没有可调出的有库存数据');
                return;
            }

            if (validRows.length < rows.length) {
                hg.msg('已自动过滤 ' + (rows.length - validRows.length) + ' 条非有库存记录');
            }

            var contentHtml = ''
                + '<form class="layui-form" lay-filter="callBoxForm" style="padding:24px 28px 8px 28px;box-sizing:border-box;">'
                + '  <div class="layui-form-item">'
                + '    <label class="layui-form-label" style="width:90px;">出库终点</label>'
                + '    <div class="layui-input-block" style="margin-left:120px;">'
                + '      <select id="outTargetSelect" lay-verify="required">'
                + '        <option value="">请选择出库终点</option>'
                + '        <option value="1001">大钻出库</option>'
                + '        <option value="1002">小钻出库</option>'
                + '      </select>'
                + '    </div>'
                + '  </div>'
                + '  <div class="layui-form-item" style="margin-bottom:0;">'
                + '    <div class="layui-input-block" style="margin-left:120px;color:#666;line-height:32px;">已选择 ' + validRows.length + ' 条库存</div>'
                + '  </div>'
                + '</form>';

            layer.open({
                type: 1,
                title: '选择出库终点',
                area: ['560px', '320px'],
                shadeClose: false,
                resize: false,
                content: contentHtml,
                btn: ['确定叫箱', '取消'],
                success: function () {
                    form.render('select');
                },
                yes: function (index) {
                    var target = $('#outTargetSelect').val();
                    if (!target) {
                        hg.msg('请选择出库终点');
                        return;
                    }

                    var payload = validRows.map(function (row) {
                        return {
                            LOCATIONCODE: row.LOCATIONCODE,
                            CONTAINER: row.CONTAINER,
                            SOURCEORDER: row.SOURCEORDER,
                            ZONECODE: row.ZONECODE
                        };
                    });

                    var loadIndex = layer.load(1);
                    $.ajax({
                        type: 'POST',
                        url: '/WMS/Inventory/CreateCallBoxTasks',
                        data: {
                            target: target,
                            items: JSON.stringify(payload)
                        },
                        dataType: 'json',
                        success: function (result) {
                            layer.close(loadIndex);
                            if (result && result.success) {
                                layer.close(index);
                                var msg = result.message || '叫箱成功';
                                if (result.skipped && result.skipped.length > 0) {
                                    msg += '，跳过 ' + result.skipped.length + ' 条：' + formatCallBoxSkipList(result.skipped);
                                }
                                hg.msg(msg);
                                hg.table.datatable('product', 'reload');
                            } else {
                                var errMsg = (result && result.message) ? result.message : '叫箱失败';
                                if (result && result.skipped && result.skipped.length > 0) {
                                    errMsg += '：' + formatCallBoxSkipList(result.skipped);
                                }
                                hg.msg(errMsg);
                            }
                        },
                        error: function (xhr) {
                            layer.close(loadIndex);
                            hg.msg('叫箱请求失败：' + (xhr.responseText || xhr.statusText));
                        }
                    });
                }
            });
        });
    }

</script>