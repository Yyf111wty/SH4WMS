<body class="layui-body-content">
    <div class="layui-fluid">
        <div class="layui-card">
            <div class="layui-card-header">
                <i class="iconfont">&#xe6ac;</i>角色权限
                <span class="layui-layout-right">
                    <a href="javascript:;" hg-event="fullscreen">
                        <i class="layui-icon layui-icon-screen-full"></i>
                    </a>
                </span>
            </div>
            <div class="layui-card-body">
                <div class="layui-row">
                    <div class="layui-row layui-col-space10">
                        <div class="layui-col-md6">
                            <div class="layui-card-header">
                                <i class="iconfont">&#xe6ac;</i>角色信息
                            </div>
                        </div>
                        <div class="layui-col-md6">
                            <div class="layui-card-header">
                                <i class="iconfont">&#xe6ac;</i>角色>>模块列表
                            </div>
                            <div class="layui-card-divs" id="group_div">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="layui-row">
                    <div class="layui-row layui-col-space10">
                        <div class="layui-col-md6">
                            <table class="layui-hide" id="test" lay-filter="test"></table>
                        </div>
                        <div class="layui-col-md6">
                            <table class="layui-table layui-form" id="userrolemodule" lay-filter="userrolemodule" lay-size="sm"></table>
                        </div>
                    </div>
                </div>                
            </div>
        </div>
