    <script>
        //注意：element未作封装处理，使用layui.use引用
        layui.use('element', function () {
            var element = layui.element;
            console.log('触发了layui.element');
        });
        function cleancache() {
            var a = hg.load(function () {
                var that = this;
                setTimeout(function () {
                    //that.close(); //关闭加载层
                    a.close();
                    hg.msghide('清除服务器缓存成功.');
                }, 2000);
            })
        }
        //加载导航和菜单栏
        $(function () {
            $.ajax({
                type: "GET",
                url: "/defeat/GetAllMeau",              
                dataType: "json",
                success: function (data) {
                    $('.layui-nav left').html();   //清空
                    $('#side-nav').html();   //清空

                    $('.layui-nav left').html(data.righthtml);   
                    $('#side-nav').html(data.lefthtml);  
                }
            });
          
        })
    </script>

