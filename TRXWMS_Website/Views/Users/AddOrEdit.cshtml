<body class="layui-body-content">
    <div class="layui-fluid">
        <div class="layui-row">
            <form class="layui-form" action="" lay-filter="example">
                <div class="layui-form-item">
                    <label class="layui-form-label" style="color:red">
                        用户名/公司
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="userName" name="userName" lay-verify="required" autocomplete="off"
                               class="layui-input">
                        <input type="hidden" name="UserGroupid" id="UserGroupid" lay-filter="UserGroupid" class="layui-input">
                        <input type="hidden" name="Id" id="Id" lay-filter="Id" class="layui-input">
                        <input type="hidden" id="type" name="type" class="layui-input">

                    </div>
                </div>
                <div class="layui-form-item" hidden>
                    <label class="layui-form-label" style="color:red">
                        代表公司
                    </label>
                    <div class="layui-input-block">
                        <input type="text" name="trueName" id="trueName" class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label" style="color:red">
                        密码
                    </label>
                    <div class="layui-input-block">
                        <input type="text" name="password" id="password" lay-verify="required" class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item" hidden>
                    <label class="layui-form-label">
                        秘钥类型
                    </label>
                    <div class="layui-input-block">
                        <select id="SecretKeyType" name="SecretKeyType" readonly></select>
                    </div>
                </div>
                <div class="layui-form-item" hidden>
                    <label class="layui-form-label">秘钥值</label>
                    <div class="layui-input-block">
                        <input type="text" id="SecretKeyValue" name="SecretKeyValue" class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label" style="color:red">所属组架</label>
                    <div class="layui-input-block">
                        <input type="text" id="tree" lay-filter="tree" class="layui-input">
                    </div>
                </div>

                <div class="layui-form-item">
                    <label class="layui-form-label">
                        手机号
                    </label>
                    <div class="layui-input-block">
                        <input type="text" name="mobile" id="mobile" class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item" hidden>
                    <label class="layui-form-label">
                        电子邮箱
                    </label>
                    <div class="layui-input-block">
                        <input type="text" name="email" id="email" class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="L_repass" class="layui-form-label"></label>
                    <button class="layui-btn" lay-filter="add" lay-submit="">确定</button>
                    <button class="layui-btn" onclick="cancelclick()">取消</button>
                </div>
            </form>
        </div>
    </div>

</body>

