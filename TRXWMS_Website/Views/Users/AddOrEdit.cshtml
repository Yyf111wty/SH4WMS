<script>
    layui.use(['form', 'layer', 'jquery'],
        function () {
            $ = layui.jquery;
            var form = layui.form,
                layer = layui.layer;
            var type = GetQueryString('type');
            //自定义验证规则
            //form.verify({
            //    uName: function (value) {
            //        if (value.length <=0) {
            //            return '不能为空';
            //        }
            //    }
            //});
            //select填充数据
            var selectdata = getSelectData();
            $("#SecretKeyType").html(selectdata);
            var selectdata = getSelectData();
            $("#SecretKeyType").html(selectdata);
            //初始化控件
            if (type == 0) {
                //$("#Name").val();
                //$("#Describe").val();
                //$("#ParentId").val("");
                //$("#Id").val("");
                form.val('example', {
                    "userName": ""// "name": "value"
                    , "type": type
                    , "UserGroupid": ""
                    , "Id": ""
                    , "trueName": ""
                    , "password": ""
                    , "mobile": ""
                    , "email": ""
                    , "SecretKeyValue": ""

                });
                form.render();
                // form.render(checkbox);
                // $(" div em").val('禁用');
            }
            else {
                var Id = GetQueryString('Id');
                var UserName = GetQueryString('UserName');
                var Password = getPWD(GetQueryString('Password'));
                var TrueName = GetQueryString('TrueName');
                var UserGroupName = GetQueryString('UserGroupName');
                var UserGroupid = GetQueryString('UserGroupid');
                var SecretKeyType = GetQueryString('SecretKeyType');
                var SecretKeyValue = GetQueryString('SecretKeyValue') == "null" ? "" : GetQueryString('SecretKeyValue');
                var Mobile = (GetQueryString('Mobile') == '' || GetQueryString('Mobile') == 'null' || GetQueryString('Mobile') == 'undefined') ? '' : GetQueryString('Mobile');
                var Email = (GetQueryString('Email') == '' || GetQueryString('Email') == 'null' || GetQueryString('Email') == 'undefined') ? '' : GetQueryString('Email');
                form.val('example', {
                    "userName": UserName
                    , "type": type
                    , "UserGroupid": UserGroupid
                    , "Id": Id
                    , "trueName": TrueName
                    , "password": Password
                    , "mobile": Mobile
                    , "email": Email
                    , "SecretKeyValue": SecretKeyValue

                });
                if (SecretKeyType != "null" & SecretKeyType != "") {
                    $("#SecretKeyType").val(SecretKeyType);
                }

                form.render();

            }


            //监听提交
            form.on('submit(add)',
                function (data) {
                    saveUserAction(data);
                    return false;
                });

        });
    layui.use(['treeSelect', 'form', 'layer'], function () {
        var treeSelect = layui.treeSelect,
            form = layui.form,
            $ = layui.jquery,
            layer = layui.layer;
        treeSelect.render({
            // 选择器
            elem: '#tree',
            // 数据
            data: '/Users/GetTreeSelectData',
            // 异步加载方式：get/post，默认get
            type: 'get',
            // 占位符
            placeholder: '请选择',
            // 是否开启搜索功能：true/false，默认false
            search: true,
            // 点击回调
            click: function (d) {
                console.log(d);
                $("#UserGroupid").val(d.current.id);
            },
            // 加载完成后的回调函数
            success: function (d) {
                var s = $("#UserGroupid").val();
                if (s != "") {
                    treeSelect.checkNode('tree', s);
                }
                var treeObj = treeSelect.zTree('tree');

                //                刷新树结构
                treeSelect.refresh('tree');

            }
        });


    });

    //获取秘钥类型数句
    function getSelectData() {
        var data;
        $.ajax({
            type: "post",
            url: '/Users/GetPlatformList',
            dataType: "json",
            async: false,
            success: function (d) {
                data = d;
            }
        });
        return data;
    }

    //获取组别下拉
    function getGroupData() {
        var data;
        $.ajax({
            type: "post",
            url: '/Users/GetGroupData',
            dataType: "json",
            async: false,
            success: function (d) {
                data = d;
            }
        });
        return data;
    }
    //获取select数句
    function getPWD(code) {
        var data;
        $.ajax({
            type: "post",
            url: '/Users/GetPWDByCode',
            data: { code: code },
            dataType: "json",
            async: false,
            success: function (d) {
                data = d;
            }
        });
        return data;
    }
    //绑定取消按钮操作
    function cancelclick() {
        hg.close();
    }
    function getToken() {
        return GetQueryString("token");
    }
    //保存、编辑操作
    function saveUserAction(data) {
        var url = data.field.type == "0"
            ? '/Users/AddUsers'
            : '/Users/EditUsers';
        if (data.field.UserGroupid == "") {
                hg.msg("所属组别不能为空！");
                return;

            }
        $.ajax({
            type: "POST",
            url: url,
            headers: {
                "Authorization": "Bearer " + getToken()  // ✅ 修复
            },
            data: data.field,
            dataType: "json",
            success: function (res) {
                if (res.result === true) {
                    hg.msghide("保存成功"); // ✅ 使用框架支持的提示
                    hg.close();
                    hg.base_reload();


                } else {
                    hg.msg("保存失败：" + (res.message || res.result));
                    hg.close();
                    hg.base_reload();
                }
            },
            error: function () {
                hg.msg("请求异常");
                hg.close();
                hg.base_reload();
            }
        });
    }
