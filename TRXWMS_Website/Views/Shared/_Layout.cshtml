                            <i class='iconfont'>&#xe623;</i><cite>权限管理模块</cite><i class='iconfont nav_right'>&#xe609;</i>
                        </a>
                        <ul class='sub-menu' style='display: block;'>
                            <li class="sub-tab" hg-title="组别管理" hg-nav="/Groups/Index">
                                <a><i class="iconfont">&#xe6ac;</i><cite>组别管理</cite></a>
                            </li>
                            <li class="sub-tab" hg-title="用户管理" hg-nav="/Users/Index">
                                <a><i class="iconfont">&#xe6ac;</i><cite>用户管理</cite></a>
                            </li>
                            <li class="sub-tab" hg-title="角色管理" hg-nav="/Roles/Index">
                                <a><i class="iconfont">&#xe6ac;</i><cite>角色管理</cite></a>
                            </li>
                            <li class="sub-tab" hg-title="权限维护" hg-nav="/Permission/Index">
                                <a><i class="iconfont">&#xe6ac;</i><cite>权限维护</cite></a>
                            </li>
                            <li class="sub-tab" hg-title="角色权限" hg-nav="/RolePermission/Index">
