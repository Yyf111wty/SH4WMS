    </div>
    <script>
        /^http(s*):\/\//.test(location.href) || alert('请先部署到 localhost 下再访问');
        //加载导航和菜单栏
        $(function () {
         
                if (top != window) {
                    
                    top.location.href = window.location.href;
                }
           
            InitLeftMenu();
        })
      

        //初始化左侧栏
        function InitLeftMenu() {
            $.ajax({
                url: "/Home/GetPermissionData",
                type: "get",
                dataType: "json",
                async: false,
                success: function (result) {

                    $('#side-nav').html('');   //清空
                    //权限系统和智能仓储
                    _menus = result;
                    var menulist = '';
                    var  othermenulist = "<ul id='nav' class='layui-tab-item layui-show'><li class='open'><li class='open'>";
                    $.each(_menus.menus, function (i, n) {
                        if (n.menuid == 1) {
                            menulist += "<ul id='nav' class='layui-tab-item '><li class='open'>";
                            menulist += "<a class='border active'> <i class='iconfont icon-list'></i><cite>" + n.menuname + "</cite><i class='iconfont nav_right'>&#xe609;</i></a> ";
                            menulist += "  <ul class='sub-menu' style='display: block;'>";
                            $.each(n.menus, function (j, o) {
                                menulist += ' <li class="sub-tab" hg-title="' + o.menuname + '" hg-nav="' + o.url + '' + '?pageId=' + o.menuid + '">   <a><i class="iconfont">&#xe6ac;</i><cite>' + o.menuname + '</cite></a></li >';
                            })
                            menulist += '</ul></li></ul>';
                            //menulist += '</ul></li>';

                        } else {
                            othermenulist += "<li class>";
                            othermenulist += '<a class="border active"> <i class="iconfont">&#xe623;</i><cite>' + n.menuname + '</cite><i class="iconfont nav_right">&#xe609;</i></a> ';
                            othermenulist += "  <ul class='sub-menu' style='display: block;'>";
                            $.each(n.menus, function (j, o) {
                                //menulist += ' <li class="sub-tab" hg-title="' + o.menuname + '" hg-nav="' + o.url + '">   <a><i class="iconfont">&#xe6ac;</i><cite>' + o.menuname + '</cite></a></li >';
                                othermenulist += ' <li class="sub-tab" hg-title="' + o.menuname + '" hg-nav="' + o.url + '' + '?pageId=' + o.menuid + '">   <a><i class="iconfont">&#xe6ac;</i><cite>' + o.menuname + '</cite></a></li >';

                            })
                            //menulist += '</ul></li></ul>';
                            othermenulist += '</ul></li>';
                        }

                    });
                    othermenulist += '</ul>';
                    var list = menulist + othermenulist;
                    $('#side-nav').html(list);   //填充
                },
                error: function (message) {
                   // $.messageBox5s('系统提示', message); return;
                }
            })
        }
        //注意：element未作封装处理，使用layui.use引用
        layui.use('element', function () {
            var element = layui.element;
            console.log('触发了layui.element');
        });
        function cleancache() {
            var a = hg.load(function () {
                var that = this;
                setTimeout(function () {
                    //that.close(); //关闭加载层
                    a.close();
                    hg.msghide('清除服务器缓存成功.');
                }, 2000);
            })
        }

    </script>

</body>

</html>




