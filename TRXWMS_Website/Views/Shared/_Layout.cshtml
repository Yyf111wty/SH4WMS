                        <ul class='sub-menu' style='display: block;'> <li class="sub-tab" hg-title="物料主表" hg-nav="/Main/Index">   <a><i class="iconfont">&#xe6ac;</i><cite>物料主表</cite></a></li> <li class="sub-tab" hg-title="库位主表" hg-nav="/Stocks/Index">   <a><i class="iconfont">&#xe6ac;</i><cite>库位主表</cite></a></li></ul>
