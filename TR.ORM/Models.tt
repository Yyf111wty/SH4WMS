<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ include file="mysqlManager.ttinclude" #>
<#@ include file="MysqlDbhelper.ttinclude" #>
<#

    bool serviceModel = false;

    // 正确连接字符串
    var connectionString = @"server=localhost;uid=root;pwd=root;database=jc0004;charset=utf8;";

    var database = new List<string> { "jc0004" };

    var copyright = DateTime.Now.Year + " xxxx Enterprises All Rights Reserved";
    var version = Environment.Version;
    var author = "auto generated by T4";

    var manager = Manager.Create(Host, GenerationEnvironment);
    var entities = EntityHelper.GetEntities(connectionString, database);

    foreach (var entity in entities)
    {
        manager.StartNewFile(entity.EntityName + ".cs");
#>
//-----------------------------------------------------------------------
// <copyright file="<#= entity.EntityName #>.cs" company="xxxx Enterprises">
// * Copyright (C) <#= copyright #>
// * version : <#= version #>
// * author  : <#= author #>
// * FileName: <#= entity.EntityName #>.cs
// * history : Created by T4 <#= DateTime.Now #>
//-----------------------------------------------------------------------
using System;
using SqlSugar;
<# if (serviceModel) { #>
using System.Runtime.Serialization;
<# } #>

namespace TR.ORM.Model
{
    /// <summary>
    /// <#= entity.EntityName #> Entity Model
    /// </summary>
    public partial class <#= entity.EntityName #>
    {
        public <#= entity.EntityName #>() { }

<#
        foreach (var field in entity.Fields)
        {
#>
        /// <summary>
        /// <#= field.Comment #>
        /// </summary>
<#
            if (field.IsPrimaryKey)
            {
#>
        [SugarColumn(IsPrimaryKey = true)]
<#
            }

            if (serviceModel)
            {
#>
        [DataMember]
<#
            }
#>
        public <#= field.Type #> <#= field.Name #> { get; set; }

<#
        }
#>
    }
}
<#
        manager.EndBlock();
    }

    manager.Process(true);
#>